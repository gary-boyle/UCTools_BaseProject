{
  "metadata": [
    {
      "src": [
        {
          "files": ["**/*.cs"],
          "src": "../Assets/Scripts"
        }
      ],
      "dest": "api",
      "allowCompilationErrors": true,
      "references": [
        "https://www.nuget.org/packages/Microsoft.NETCore.App/",
        "../Library/ScriptAssemblies/UnityEngine.dll",
        "../Library/ScriptAssemblies/UnityEditor.dll"
      ]
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/*.yml",
          "api/index.md"
        ],
        "dest": "api"
      },
      {
        "files": [
          "articles/**.md"
        ],
        "dest": "articles"
      },
      {
        "files": [
          "*.md"
        ],
        "dest": "."
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "dest": "images"
      }
    ],
    "output": "_site",
    "template": [
      "default", 
      "templates/darkfx"
    ],
    "globalMetadata": {
            "_appTitle": "UCTools Base Project",
      "_appName": "UCTools",
      "_appFooter": "© 2025 UCTools Base Project Documentation",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_disableContribution": false,
      "_disableToc": false,
      "_disableAffix": false,
      "_tocRel": "toc.html",
      "_enableMemberList": true,
      "_gitContribute": {
        "repo": "https://github.com/gary-boyle/UCTools_BaseProject",
        "branch": "main"
      },
      "_gitUrlPattern": "github"
    },
    "dest": "_site",
     "fileMetadata": {
      "_displayExceptions": {
        "api/*.yml": true
              },
      "_disableContribution": {
        "api/**": true
      }
    }
  }
}
