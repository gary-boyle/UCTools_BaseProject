umber=\"5\" sourceendlinenumber=\"7\">Design: Service container with constructor injection and dependency graph resolution\nPros: Clean separation of concerns, automatic dependency resolution, easy testing, loose coupling\nCons: Runtime dependency resolution, potential circular dependencies, reflection overhead</p>\n"},"GameFramework.ConsoleTool.IConsoleUI.SetPrompt*":{"uid":"GameFramework.ConsoleTool.IConsoleUI.SetPrompt*","name":"SetPrompt","href":null,"commentId":"Overload:GameFramework.ConsoleTool.IConsoleUI.SetPrompt","isSpec":"True","fullName":"GameFramework.ConsoleTool.IConsoleUI.SetPrompt","nameWithType":"IConsoleUI.SetPrompt"},"GameFramework.Services.UIService.ShowPopupAsync*":{"uid":"GameFramework.Services.UIService.ShowPopupAsync*","name":"ShowPopupAsync","href":null,"commentId":"Overload:GameFramework.Services.UIService.ShowPopupAsync","isSpec":"True","fullName":"GameFramework.Services.UIService.ShowPopupAsync","nameWithType":"UIService.ShowPopupAsync"},"GameFramework.Services.TimeService.GetFormattedSessionTime*":{"uid":"GameFramework.Services.TimeService.GetFormattedSessionTime*","name":"GetFormattedSessionTime","href":null,"commentId":"Overload:GameFramework.Services.TimeService.GetFormattedSessionTime","isSpec":"True","fullName":"GameFramework.Services.TimeService.GetFormattedSessionTime","nameWithType":"TimeService.GetFormattedSessionTime"},"GameFramework.Input.InputHandlerBase.Name*":{"uid":"GameFramework.Input.InputHandlerBase.Name*","name":"Name","href":null,"commentId":"Overload:GameFramework.Input.InputHandlerBase.Name","isSpec":"True","fullName":"GameFramework.Input.InputHandlerBase.Name","nameWithType":"InputHandlerBase.Name"},"GameFramework.UI.Screens.SaveGamePopup.SetupSpecificFunctionality*":{"uid":"GameFramework.UI.Screens.SaveGamePopup.SetupSpecificFunctionality*","name":"SetupSpecificFunctionality","href":null,"commentId":"Overload:GameFramework.UI.Screens.SaveGamePopup.SetupSpecificFunctionality","isSpec":"True","fullName":"GameFramewo