.EnumConfigVariable{UCTools_ConfigVariables.ResolutionOption}.GetValueAsString","isSpec":"True","fullName":"UCTools_ConfigVariables.EnumConfigVariable<UCTools_ConfigVariables.ResolutionOption>.GetValueAsString()","fullName.vb":"UCTools_ConfigVariables.EnumConfigVariable(Of UCTools_ConfigVariables.ResolutionOption).GetValueAsString()","nameWithType":"EnumConfigVariable<ResolutionOption>.GetValueAsString()","nameWithType.vb":"EnumConfigVariable(Of ResolutionOption).GetValueAsString()"},"GameFramework.UI.Screens.VictoryScreen.#ctor*":{"uid":"GameFramework.UI.Screens.VictoryScreen.#ctor*","name":"VictoryScreen","href":null,"commentId":"Overload:GameFramework.UI.Screens.VictoryScreen.#ctor","isSpec":"True","fullName":"GameFramework.UI.Screens.VictoryScreen.VictoryScreen","nameWithType":"VictoryScreen.VictoryScreen"},"GameFramework.Services.ConfigService.GetConfigValue*":{"uid":"GameFramework.Services.ConfigService.GetConfigValue*","name":"GetConfigValue","href":null,"commentId":"Overload:GameFramework.Services.ConfigService.GetConfigValue","isSpec":"True","fullName":"GameFramework.Services.ConfigService.GetConfigValue","nameWithType":"ConfigService.GetConfigValue"},"GameFramework.ConsoleTool.Commands.ConsoleCommandRegistry.GetCommandNames*":{"uid":"GameFramework.ConsoleTool.Commands.ConsoleCommandRegistry.GetCommandNames*","name":"GetCommandNames","href":null,"commentId":"Overload:GameFramework.ConsoleTool.Commands.ConsoleCommandRegistry.GetCommandNames","isSpec":"True","fullName":"GameFramework.ConsoleTool.Commands.ConsoleCommandRegistry.GetCommandNames","nameWithType":"ConsoleCommandRegistry.GetCommandNames"},"GameFramework.UI.Screens.SplashScreen.#ctor*":{"uid":"GameFramework.UI.Screens.SplashScreen.#ctor*","name":"SplashScreen","href":null,"commentId":"Overload:GameFramework.UI.Screens.SplashScreen.#ctor","isSpec":"True","fullName":"GameFramework.UI.Screens.SplashScreen.SplashScreen","nameWithType":"SplashScreen.SplashScreen"},"IEventSystem":{"uid":"IEventSystem","na