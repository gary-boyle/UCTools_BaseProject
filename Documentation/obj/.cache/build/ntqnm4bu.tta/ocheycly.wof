hType":"Dictionary<String, Int32>","nameWithType.vb":"Dictionary(Of String, Int32)"},"GameFramework.Services.ConsoleService":{"uid":"GameFramework.Services.ConsoleService","name":"ConsoleService","href":null,"commentId":"T:GameFramework.Services.ConsoleService","isSpec":"True","fullName":"GameFramework.Services.ConsoleService","nameWithType":"ConsoleService","summary":"<p sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Service that orchestrates the debug console system using dependency injection.</p>\n<p sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Architecture:</p>\n<ul sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Manages console state (open/closed)</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Provides public API for other systems to interact with console</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Respects debug settings from configuration</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Input conflict management is handled by ConsoleInputHandler</li>\n</ul>\n<p sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Flow:</p>\n<ol sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"15\">\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Receives toggle input events from InputManager</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">Checks if console is enabled in debug settings</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Updates console open/closed state only if enabled</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">ConsoleInputHandler automatically manages input conflicts by checking IsConsoleOpen()</li>\n<li sourcefile=\"api/GameFramework.Services.ConsoleService.yml\" sourcestartlinenumber=\"15\" sourceendlinenumber=\"15\">Delegates UI updates to ConsoleGUI via Console static class</li>\n</ol>\n"},"GameFramework.ConsoleTool.Commands.ExecCommand.Description*":{"uid":"GameFramework.ConsoleTool.Commands.ExecCommand.Description*","name":"Description","href":null,"commentId":"Overload:GameFramework.ConsoleTool.Commands.ExecCommand.Description","isSpec":"True","fullName":"GameFramework.ConsoleTool.Commands.ExecCommand.Description","nameWithType":"ExecCommand.Description"},"GameFramework.ConsoleTool.IConsoleCommand.CommandName*":{"uid":"GameFramework.ConsoleTool.IConsoleCommand.CommandName*","name":"CommandName","href":null,"commentId":"Overload:GameFramework.ConsoleTool.IConsoleCommand.CommandName","isSpec":"True","fullName":"GameFramework.ConsoleTool.IConsoleCommand.CommandName","nameWithType":"IConsoleCommand.CommandName"},"GameFramework.EventSystem.Events.PlayerPreviousInputEvent.#ctor*":{"uid":"GameFramework.EventSystem.Events.PlayerPreviousInputEvent.#ctor*","name":"PlayerPreviousInputEvent","href":null,"commentId":"Overload:GameFramework.EventSystem.Events.PlayerPreviousInputEvent.#ctor","isSpec":"True","fullName":"GameFramework.EventSystem.Events.PlayerPreviousInputEvent.PlayerPreviousInputEvent","nameWithType":"PlayerPreviousInputEvent.PlayerPreviousInputEvent"},"GameFramework.Services.TimeService.LevelTime*":{"uid":"GameFramework.Services.T