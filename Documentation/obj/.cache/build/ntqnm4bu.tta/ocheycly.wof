k.ConsoleTool.Console","name":"Console","href":null,"commentId":"T:GameFramework.ConsoleTool.Console","isSpec":"True","fullName":"GameFramework.ConsoleTool.Console","nameWithType":"Console","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Core console system that manages command execution, history, and output.</p>\n<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Architecture:</p>\n<ul sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Static class for global access (consider making non-static in future for better testability)</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Manages command queue, history, and execution</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Delegates UI operations to registered IConsoleUI implementation</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Thread-safe command queuing for commands from other threads</li>\n</ul>\n<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Command Execution Flow:</p>\n<ol sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"14\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Commands are queued via EnqueueCommand()</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">ConsoleUpdate() processes the queue each frame</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Commands are tokenized and looked up in registry</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">Command execution results are output to console</li>\n</ol>\n"},"UCTools_ConfigVariables.ResolutionOptionExtensions.GetAllDisplayNames*":{"uid":"UCTools_ConfigVariables.ResolutionOptionExtensions.GetAllDisplayNames*","name":"GetAllDisplayNames","href":null,"commentId":"Overload:UCTools_ConfigVariables.ResolutionOptionExtensions.GetAllDisplayNames","isSpec":"True","fullName":"UCTools_ConfigVariables.ResolutionOptionExtensions.GetAllDisplayNames","nameWithType":"ResolutionOptionExtensions.GetAllDisplayNames"},"GameFramework.Input.InputHandlerBase":{"uid":"GameFramework.Input.InputHandlerBase","name":"InputHandlerBase","href":null,"commentId":"T:GameFramework.Input.InputHandlerBase","isSpec":"True","fullName":"GameFramework.Input.InputHandlerBase","nameWithType":"InputHandlerBase","summary":"<p sourcefile=\"api/GameFramework.Input.InputHandlerBase.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Base class for all input handlers\nEach handler is responsible for one specific type of input (UI, Player, Console, etc.)</p>\n"},"GameFramework.StateMachine.IGameStateMachine.CurrentStateType":{"uid":"GameFramework.StateMachine.IGameStateMachine.CurrentStateType","name":"CurrentStateType","href":null,"commentId":"P:GameFramework.StateMachine.IGameStateMachine.CurrentStateType","isSpec":"True","fullName":"GameFramework.StateMachine.IGameStateMachine.CurrentStateType","nameWithType":"IGameStateMachine.CurrentStateType"},"GameFramework.Input.Handlers.ConsoleInputHandler.#ctor*":{"uid":"GameFramework.Input.Handlers.ConsoleInputHandler.#ctor*","name":"ConsoleInputHandler","href":null,"commentId":"Overload:GameFramework.Input.Handlers.ConsoleInputHandler.#ctor","isSpec":"True","fullName":"Game