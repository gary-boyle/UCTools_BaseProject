rvices.SaveService","nameWithType":"SaveService","summary":"<p sourcefile=\"api/GameFramework.Services.SaveService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"7\">Enhanced save service that handles both file operations and UI support\nProvides clean separation between low-level file I/O and high-level UI operations\nUses timestamp-based naming for all save files with special autosave handling\nAutosaves always overwrite existing autosave files to prevent save directory bloat\nWorks with GameDataService as the single source of session data\nIntegrates with TimeService for accurate playtime tracking</p>\n"},"UCTools_ConfigVariables.EnumConfigVariable{UCTools_ConfigVariables.QualityOption}.GetValueAsString":{"uid":"UCTools_ConfigVariables.EnumConfigVariable{UCTools_ConfigVariables.QualityOption}.GetValueAsString","name":"GetValueAsString()","href":null,"commentId":"M:UCTools_ConfigVariables.EnumConfigVariable{UCTools_ConfigVariables.QualityOption}.GetValueAsString","isSpec":"True","fullName":"UCTools_ConfigVariables.EnumConfigVariable<UCTools_ConfigVariables.QualityOption>.GetValueAsString()","fullName.vb":"UCTools_ConfigVariables.EnumConfigVariable(Of UCTools_ConfigVariables.QualityOption).GetValueAsString()","nameWithType":"EnumConfigVariable<QualityOption>.GetValueAsString()","nameWithType.vb":"EnumConfigVariable(Of QualityOption).GetValueAsString()"},"GameFramework.ConsoleTool.Commands.ExecCommand.Category*":{"uid":"GameFramework.ConsoleTool.Commands.ExecCommand.Category*","name":"Category","href":null,"commentId":"Overload:GameFramework.ConsoleTool.Commands.ExecCommand.Category","isSpec":"True","fullName":"GameFramework.ConsoleTool.Commands.ExecCommand.Category","nameWithType":"ExecCommand.Category"},"GameFramework.StateMachine.Enum.GameStateType":{"uid":"GameFramework.StateMachine.Enum.GameStateType","name":"GameStateType","href":null,"commentId":"T:GameFramework.StateMachine.Enum.GameStateType","isSpec":"True","fullName":"GameFramework.StateMachine.E