"summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Console GUI component responsible for rendering console UI and handling user input.</p>\n<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Architecture:</p>\n<ul sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Pure UI component - only handles visual representation</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Subscribes to console-specific input events (not toggle - that&apos;s handled by ConsoleService)</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Uses events to communicate back to console system</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Optimized string building for better performance</li>\n</ul>\n<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Input Handling Flow:</p>\n<ol sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"14\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">InputManager detects console input (submit, tab, history) </li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">InputManager publishes console input events</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">ConsoleGUI receives events and updates UI accordingly</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">ConsoleGUI calls Console static methods to execute commands</li>\n</ol>\n"},"GameFramework.UI.UIScreen.Show*":{"uid":"GameFramework.UI.UIScreen.Show*","name":"Show","href":null,"commentId":"Overload:GameFramework.UI.UIScreen.Show","isSpec":"True","fullName":"GameFramework.UI.UIScreen.Show","nameWithType":"UIScreen.Show"},"BaseGameState.StateMachine":{"uid":"BaseGameState.StateMachine","name":"StateMachine","href":null,"commentId":"F:BaseGameState.StateMachine","isSpec":"True","fullName":"BaseGameState.StateMachine","nameWithType":"BaseGameState.StateMachine"},"GameFramework.Tests.HelperClasses.TestService":{"uid":"GameFramework.Tests.HelperClasses.TestService","name":"TestService","href":null,"commentId":"T:GameFramework.Tests.HelperClasses.TestService","isSpec":"True","fullName":"GameFramework.Tests.HelperClasses.TestService","nameWithType":"TestService","summary":"<p sourcefile=\"api/GameFramework.Tests.HelperClasses.TestService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Test service with optional dependency injection\nModified to have clearer constructor behavior for testing</p>\n"},"GameFramework.UI.Screens.SaveFileListPopup.RegisterSpecificEventHandlers*":{"uid":"GameFramework.UI.Screens.SaveFileListPopup.RegisterSpecificEventHandlers*","name":"RegisterSpecificEventHandlers","href":null,"commentId":"Overload:GameFramework.UI.Screens.SaveFileListPopup.RegisterSpecificEventHandlers","isSpec":"True","fullName":"GameFramework.UI.Screens.SaveFileListPopup.RegisterSpecificEventHandlers","nameWithType":"SaveFileListPopup.RegisterSpecificEventHandlers"},"GameFramework.EventSystem.Events.UINavigateInputEvent":{"uid":"GameFramework.EventSystem.Events.UINavigateInputEvent","name":"UINavigateInputEvent","href":null,"commentId":"T:GameFramework.EventSystem.Events.UINavigateInputEvent","isSpec":"True","fullName"