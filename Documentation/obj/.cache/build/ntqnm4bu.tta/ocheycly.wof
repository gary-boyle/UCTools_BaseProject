eFramework.Tests.DIContainerTests","nameWithType":"DIContainerTests","summary":"<p sourcefile=\"api/GameFramework.Tests.DIContainerTests.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Comprehensive test suite for DIContainer class.\nTests singleton registration, factory registration, dependency resolution,\ncircular dependency detection, and error handling.</p>\n<p sourcefile=\"api/GameFramework.Tests.DIContainerTests.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"8\">Design: Isolated unit tests with proper setup/teardown and dependency management\nPros: Thorough coverage, edge case testing, clear test structure, proper DI testing\nCons: Requires mock objects, potential test maintenance overhead</p>\n"},"GameFramework.UI.Screens.GamePlayScreen.OnUpdate*":{"uid":"GameFramework.UI.Screens.GamePlayScreen.OnUpdate*","name":"OnUpdate","href":null,"commentId":"Overload:GameFramework.UI.Screens.GamePlayScreen.OnUpdate","isSpec":"True","fullName":"GameFramework.UI.Screens.GamePlayScreen.OnUpdate","nameWithType":"GamePlayScreen.OnUpdate"},"GameFramework.Core.GameContext.UIService*":{"uid":"GameFramework.Core.GameContext.UIService*","name":"UIService","href":null,"commentId":"Overload:GameFramework.Core.GameContext.UIService","isSpec":"True","fullName":"GameFramework.Core.GameContext.UIService","nameWithType":"GameContext.UIService"},"GameFramework.EventSystem.Events.PlayerNextInputEvent":{"uid":"GameFramework.EventSystem.Events.PlayerNextInputEvent","name":"PlayerNextInputEvent","href":null,"commentId":"T:GameFramework.EventSystem.Events.PlayerNextInputEvent","isSpec":"True","fullName":"GameFramework.EventSystem.Events.PlayerNextInputEvent","nameWithType":"PlayerNextInputEvent"},"UCTools_ConfigVariables.EnumConfigVariable`1.ResetToDefault":{"uid":"UCTools_ConfigVariables.EnumConfigVariable`1.ResetToDefault","name":"ResetToDefault()","href":null,"commentId":"M:UCTools_ConfigVariables.EnumConfigVariable`1.ResetToDefault","isSpec":"True","fullName":"UCTools_ConfigVariables.EnumConfigVariable<T>.ResetToDefault()","fullName.vb":"UCTools_ConfigVariables.EnumConfigVariable(Of T).ResetToDefault()","nameWithType":"EnumConfigVariable<T>.ResetToDefault()","nameWithType.vb":"EnumConfigVariable(Of T).ResetToDefault()"},"GameFramework.Tests.DIContainerTests.Resolve_SimpleServiceWithoutDependencies_ShouldCreateInstance*":{"uid":"GameFramework.Tests.DIContainerTests.Resolve_SimpleServiceWithoutDependencies_ShouldCreateInstance*","name":"Resolve_SimpleServiceWithoutDependencies_ShouldCreateInstance","href":null,"commentId":"Overload:GameFramework.Tests.DIContainerTests.Resolve_SimpleServiceWithoutDependencies_ShouldCreateInstance","isSpec":"True","fullName":"GameFramework.Tests.DIContainerTests.Resolve_SimpleServiceWithoutDependencies_ShouldCreateInstance","nameWithType":"DIContainerTests.Resolve_SimpleServiceWithoutDependencies_ShouldCreateInstance"},"GameFramework.Services.ConfigService":{"uid":"GameFramework.Services.ConfigService","name":"ConfigService","href":null,"commentId":"T:GameFramework.Services.ConfigService","isSpec":"True","fullName":"GameFramework.Services.ConfigService","nameWithType":"ConfigService","summary":"<p sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Configuration service implementation with typed ScriptableObject ConfigCategory integration and query support</p>\n<p sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"6\">Intent: Centralized configuration management with ScriptableObject registry and query capabilities\nDesign: Service locator pattern with type-based lookup for ScriptableObjects\nPros: </p>\n<ul sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"13\">\n<li sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Centralized ScriptableObject management</li>\n<li sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Type-safe querying</li>\n<li sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"9\" sourceendlinenumber=\"9\">Clean separation of concerns</li>\n<li sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"11\">Easy testing and mocking\nCons:</li>\n<li sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">Additional complexity for ScriptableObject management</li>\n<li sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Memory overhead for type dictionaries</li>\n</ul>\n"},"GameFramework.ConsoleTool.IConsoleContext.SetWaitFrames(System.Int32)":{"uid":"GameFramework.ConsoleTool.IConsoleContext.SetWaitFrames(System.Int32)","name":"SetWaitFrames(Int32)","href":null,"commentId":"M:GameFramework.ConsoleTool.IConsoleContext.SetWaitFrames(System.Int32)","fullName":"GameFramework.ConsoleTool.IConsoleContext.SetWaitFrames(System.Int32)","nameWithType":"IConsoleContext.SetWaitFrames(Int32)"},"UCTools_ConfigVariables.FloatConfigVariable.GetValueAsString*":{"uid":"UCTools_ConfigVariables.FloatConfigVariable.GetValueAsString*","name":"GetValueAsString","href":null,"commentId":"Overload:UCTools_ConfigVariables.FloatConfigVariable.GetValueAsString","isSpec":"True","fullName":"UCTools_ConfigVariables.FloatConfigVariable.GetValueAsString","nameWithType":"FloatConfigVariable.GetValueAsString"},"PlayerInputHandler":{"uid":"PlayerInputHandler","name":"PlayerInputHandler","href":null,"commentId":"!:PlayerInputHandler","fullName":"PlayerInputHandler","nameWithType":"PlayerInputHandler"},"GameFramework.ConsoleTool.IConsoleCommand.ValidateArgs(System.String[])":{"uid":"GameFramework.ConsoleTool.IConsoleCommand.ValidateArgs(System.String[])","name":"ValidateArgs