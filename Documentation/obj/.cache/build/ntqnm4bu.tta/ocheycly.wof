Commands.ExampleCommand.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Usage Examples:</p>\n<blockquote sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"9\"><p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"9\">spawn                    - Creates a cube at origin (0,0,0)\nspawn sphere             - Creates a sphere at origin\nspawn cube 5 10 0        - Creates a cube at position (5, 10, 0)\nspawn cylinder 0 5 0 red - Creates a red cylinder at (0, 5, 0)</p>\n</blockquote>\n<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"12\">This serves as a template for creating your own console commands\nCopy this file and modify it to create new functionality</p>\n"},"GameFramework.Services.TimeService.Update*":{"uid":"GameFramework.Services.TimeService.Update*","name":"Update","href":null,"commentId":"Overload:GameFramework.Services.TimeService.Update","isSpec":"True","fullName":"GameFramework.Services.TimeService.Update","nameWithType":"TimeService.Update"},"GameFramework.Services.Interfaces.ITimeService.GetTimeStatistics*":{"uid":"GameFramework.Services.Interfaces.ITimeService.GetTimeStatistics*","name":"GetTimeStatistics","href":null,"commentId":"Overload:GameFramework.Services.Interfaces.ITimeService.GetTimeStatistics","isSpec":"True","fullName":"GameFramework.Services.Interfaces.ITimeService.GetTimeStatistics","nameWithType":"ITimeService.GetTimeStatistics"},"GameFramework.Services.SceneService.IsInitialized*":{"uid":"GameFramework.Services.SceneService.IsInitialized*","name":"IsInitialized","href":null,"commentId":"Overload:GameFramework.Services.SceneService.IsInitialized","isSpec":"True","fullName":"GameFramework.Services.SceneService.IsInitialized","nameWithType":"SceneService.IsInitialized"},"GameFramework.ConsoleTool.Commands.Consol