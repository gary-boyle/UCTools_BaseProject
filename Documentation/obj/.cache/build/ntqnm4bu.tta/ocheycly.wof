eService.PauseGame*","name":"PauseGame","href":null,"commentId":"Overload:GameFramework.Services.Interfaces.IPauseService.PauseGame","isSpec":"True","fullName":"GameFramework.Services.Interfaces.IPauseService.PauseGame","nameWithType":"IPauseService.PauseGame"},"GameFramework.UI.Utilities.GraphElement":{"uid":"GameFramework.UI.Utilities.GraphElement","name":"GraphElement","href":null,"commentId":"T:GameFramework.UI.Utilities.GraphElement","isSpec":"True","fullName":"GameFramework.UI.Utilities.GraphElement","nameWithType":"GraphElement","summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Custom UI element that renders a simple line graph for performance metrics</p>\n<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Design:</p>\n<ul sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Uses Unity&apos;s MeshGenerationContext for efficient rendering</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Circular buffer for memory-efficient data storage</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Configurable colors, ranges, and smoothing</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Auto-scaling based on data range</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Pros:</p>\n<ul sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"14\">\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Efficient rendering using Unity&apos;s native mesh generation</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">Memory efficient with fixed-size circular buffer</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Smooth visual updates with configurable sampling</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">Auto-scaling prevents data clipping</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"16\" sourceendlinenumber=\"16\">Cons:</p>\n<ul sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"17\" sourceendlinenumber=\"19\">\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"17\" sourceendlinenumber=\"17\">Custom rendering adds complexity</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"18\" sourceendlinenumber=\"18\">Limited to simple line graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"19\" sourceendlinenumber=\"19\">Requires manual styling integration</li>\n</ul>\n"},"GameFramework.Services.Interfaces.ITimeService.SessionTime*":{"uid":"GameFramework.Services.Interfaces.ITimeService.SessionTime*","name":"SessionTime","href":null,"commentId":"Overload:GameFramework.Services.Interfaces.ITimeService.SessionTime","isSpec":"True","fullName":"GameFramework.Services.Interfaces.ITimeService.SessionTime","nameWithType":"ITimeService.SessionTime"},"GameFramework.Input.InputHandlerBase.ConsumeInput":{"uid":"GameFramework.Input.InputHandlerBase.ConsumeInput","name":"ConsumeInput","href":null,"commentId":"P:GameFramework.Inpu