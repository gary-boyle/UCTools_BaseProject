Type":"IGameStateMachine","summary":"<p sourcefile=\"api/GameFramework.StateMachine.IGameStateMachine.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Advanced state machine with constructor injection support.\nAll dependencies are injected rather than resolved from service locator.\nUses explicit state definitions for maximum Unity compatibility.</p>\n<p sourcefile=\"api/GameFramework.StateMachine.IGameStateMachine.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"8\">Design: State machine pattern with async support and transition validation\nPros: Robust state management, prevents invalid transitions, supports complex state logic, Unity compatible\nCons: More complex than simple state switching, requires careful transition planning, explicit state definitions</p>\n"},"GameFramework.Tests.UI.UIServiceIntegrationTests":{"uid":"GameFramework.Tests.UI.UIServiceIntegrationTests","name":"UIServiceIntegrationTests","href":null,"commentId":"T:GameFramework.Tests.UI.UIServiceIntegrationTests","isSpec":"True","fullName":"GameFramework.Tests.UI.UIServiceIntegrationTests","nameWithType":"UIServiceIntegrationTests"},"UCTools_ConfigVariables.EnumConfigVariable`1.DefaultValue*":{"uid":"UCTools_ConfigVariables.EnumConfigVariable`1.DefaultValue*","name":"DefaultValue","href":null,"commentId":"Overload:UCTools_ConfigVariables.EnumConfigVariable`1.DefaultValue","isSpec":"True","fullName":"UCTools_ConfigVariables.EnumConfigVariable<T>.DefaultValue","fullName.vb":"UCTools_ConfigVariables.EnumConfigVariable(Of T).DefaultValue","nameWithType":"EnumConfigVariable<T>.DefaultValue","nameWithType.vb":"EnumConfigVariable(Of T).DefaultValue"},"GameFramework.Services.AudioService.#ctor*":{"uid":"GameFramework.Services.AudioService.#ctor*","name":"AudioService","href":null,"commentId":"Overload:GameFramework.Services.AudioService.#ctor","isSpec":"True","fullName":"GameFramework.Services.AudioService.AudioService","nameWithType":"AudioService.AudioService"},"GameFramework.EventS