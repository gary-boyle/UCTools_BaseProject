"GameFramework.ConsoleTool.IConsoleContext","name":"IConsoleContext","href":null,"commentId":"T:GameFramework.ConsoleTool.IConsoleContext","isSpec":"True","fullName":"GameFramework.ConsoleTool.IConsoleContext","nameWithType":"IConsoleContext","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Context interface providing access to console functionality\nAllows commands to interact with the console system safely without direct access to internal state\nActs as a controlled facade that prevents commands from breaking console integrity</p>\n"},"GrameFramework.Config.GameplaySettings_SO.GetAllVariables*":{"uid":"GrameFramework.Config.GameplaySettings_SO.GetAllVariables*","name":"GetAllVariables","href":null,"commentId":"Overload:GrameFramework.Config.GameplaySettings_SO.GetAllVariables","isSpec":"True","fullName":"GrameFramework.Config.GameplaySettings_SO.GetAllVariables","nameWithType":"GameplaySettings_SO.GetAllVariables"},"GameFramework.Tests.EventSystemTests":{"uid":"GameFramework.Tests.EventSystemTests","name":"EventSystemTests","href":null,"commentId":"T:GameFramework.Tests.EventSystemTests","isSpec":"True","fullName":"GameFramework.Tests.EventSystemTests","nameWithType":"EventSystemTests","summary":"<p sourcefile=\"api/GameFramework.Tests.EventSystemTests.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Comprehensive test suite for EventSystem class.\nTests event subscription, publishing, error handling, and lifecycle management.</p>\n<p sourcefile=\"api/GameFramework.Tests.EventSystemTests.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"7\">Design: Isolated tests with event handler validation\nPros: Covers all event system functionality, tests error scenarios\nCons: Async testing complexity, event handler timing considerations</p>\n"},"GameFramework.ConsoleTool.Commands.ConsoleCommandBase.Tag":{"uid":"GameFramework.ConsoleTool.Commands.ConsoleCommandBase.Tag","nam