veService","name":"ISaveService","href":null,"fullName":"ISaveService","nameWithType":"ISaveService"},"GameFramework.Services.UIService.RegisterPopup*":{"uid":"GameFramework.Services.UIService.RegisterPopup*","name":"RegisterPopup","href":null,"commentId":"Overload:GameFramework.Services.UIService.RegisterPopup","isSpec":"True","fullName":"GameFramework.Services.UIService.RegisterPopup","nameWithType":"UIService.RegisterPopup"},"GameFramework.Input.InputHandlerBase.UnsubscribeFromEvents*":{"uid":"GameFramework.Input.InputHandlerBase.UnsubscribeFromEvents*","name":"UnsubscribeFromEvents","href":null,"commentId":"Overload:GameFramework.Input.InputHandlerBase.UnsubscribeFromEvents","isSpec":"True","fullName":"GameFramework.Input.InputHandlerBase.UnsubscribeFromEvents","nameWithType":"InputHandlerBase.UnsubscribeFromEvents"},"GameFramework.UI.Popups.DebugPopup":{"uid":"GameFramework.UI.Popups.DebugPopup","name":"DebugPopup","href":null,"commentId":"T:GameFramework.UI.Popups.DebugPopup","isSpec":"True","fullName":"GameFramework.UI.Popups.DebugPopup","nameWithType":"DebugPopup","summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Enhanced debug popup with real-time performance graphs\nDisplays FPS, memory consumption, and historical graphs of both metrics</p>\n<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Design:</p>\n<ul sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"9\">\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Integrates custom GraphElement controls for visual data representation</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Maintains separate data collection intervals for metrics vs graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Uses color-coded indicators for quick performance assessment</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"9\" sourceendlinenumber=\"9\">Efficient data sampling to prevent performance impact</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Pros:</p>\n<ul sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"17\">\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">Visual trend analysis with historical graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Real-time performance monitoring with color coding</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">Memory efficient circular buffers for data storage</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"15\" sourceendlinenumber=\"15\">Configurable graph appearance and scaling</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"16\" sourceendlinenumber=\"16\">Clean separation between text metrics and visual graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"17\" sourceendlinenumber=\"17\">Can be toggled on/off as overlay popup</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"19\" sourceendlinenumber=\"19\">Cons:</p>\n<ul sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"20\" sourceendlinenumber=\"22\">\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"20\" sourceendlinenumber=\"20\">Increased memory usage for graph data storage</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"21\" sourceendlinenumber=\"21\">Additional rendering overhead for custom graph elements</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"22\" sourceendlinenumber=\"22\">More complex initialization and cleanup</li>\n</ul>\n"},"GameFramework.StateMachine.GameStateMachine.GetStateByStateType*":{"uid":"GameFramework.StateMachine.GameStateMachine.GetStateByStateType*","name":"GetStateByStateType","href":null,"commentId":"Overload:GameFramework.StateMachine.GameStateMachine.GetStateByStateType","isSpec":"True","fullName":"GameFramework.StateMachine.GameStateMachine.GetStateByStateType","nameWithType":"GameStateMachine.GetStateByStateType"},"GameFramework.Tests.EventSystemTests.Shutdown_ShouldClearAndResetInitialization*":{"uid":"GameFramework.Tests.EventSystemTests.Shutdown_ShouldClearAndResetInitialization*","name":"Shutdown_ShouldClearAndResetInitialization","href":null,"commentId":"Overload:GameFramework.Tests.EventSystemTests.Shutdown_ShouldClearAndResetInitialization","isSpec":"True","fullName":"GameFramework.Tests.EventSystemTests.Shutdown_ShouldClearAndResetInitialization","nameWithType":"EventSystemTests.Shutdown_ShouldClearAndResetInitialization"},"Color":{"uid":"Color","name":"Color","href":null,"fullName":"Color","nameWithType":"Color"},"GameFramework.Tests.EventSystemTests.Subscribe_WithParameterlessHandler_ShouldReceiveEvents*":{"uid":"GameFramework.Tests.EventSystemTests.Subscribe_WithParameterlessHandler_ShouldReceiveEvents*","name":"Subscribe_WithParameterlessHandler_ShouldReceiveEvents","href":null,"commentId":"Overload:GameFramework.Tests.EventSystemTests.Subscribe_WithParameterlessHandler_ShouldReceiveEvents","isSpec":"True","fullName":"GameFramework.Tests.EventSystemTests.Subscribe_WithParameterlessHandler_ShouldReceiveEvents","nameWithType":"EventSystemTests.Subscribe_WithParameterl