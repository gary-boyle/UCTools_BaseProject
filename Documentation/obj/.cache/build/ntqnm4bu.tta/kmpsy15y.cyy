  <h1 id="GameFramework_DataStructures_GameSession" data-uid="GameFramework.DataStructures.GameSession" class="text-break">
    Class GameSession
    
  </h1>
  
  <div class="facts text-secondary">
    <dl><dt>Namespace</dt><dd><a class="xref" href="GameFramework.DataStructures.html">GameFramework.DataStructures</a></dd></dl>
