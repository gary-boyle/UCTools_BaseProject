ice.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if a save file can be loaded</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.LoadService.CanLoadGame(SaveFileInfo)","Summary":"<p sourcefile=\"api/GameFramework.Services.LoadService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if a save file can be loaded using SaveFileInfo</p>\n","Type":"method","Syntax":{"content":"public async Task<bool> CanLoadGame(SaveFileInfo saveFileInfo)","parameters":[{"id":"saveFileInfo","type":"SaveFileInfo"}],"return":{"type":"Task{System.Boolean}"},"content.vb":"Public Function CanLoadGame(saveFileInfo As SaveFileInfo) As Task(Of Boolean)"},"File":"api/GameFramework.Services.LoadService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.LoadService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if a save file can be loaded using SaveFileInfo</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Interfaces","Type":"namespace","File":"api/GameFramework.StateMachine.Interfaces.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.ISceneService","Summary":"<p sourcefile=\"api/GameFramework.Services.Interfaces.ISceneService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Interface for scene management service</p>\n","Type":"interface","Syntax":{"content":"public interface ISceneService : IGameService","content.vb":"Public Interface ISceneService\n    Inherits IGameService"},"File":"api/GameFramework.Services.Interfaces.ISceneService.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.ISceneService.LoadSceneAsync(System.String)","Type":"method","Syntax":{"content":"Task LoadSceneAsync(string sceneName)","parameters":[{"id":"sceneName","type":"System.String"}],"return":{"type":"Task"},"content.vb":"Function LoadSceneAsync(sceneName As String) As Task"},"File":"api/GameFramework.Services.Interfaces.ISceneService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.ISceneService.LoadSceneAdditiveAsync(System.String)","Type":"method","Syntax":{"content":"Task LoadSceneAdditiveAsync(string sceneName)","parameters":[{"id":"sceneName","type":"System.String"}],"return":{"type":"Task"},"content.vb":"Function LoadSceneAdditiveAsync(sceneName As String) As Task"},"File":"api/GameFramework.Services.Interfaces.ISceneService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.ISceneService.UnloadSceneAsync(System.String)","Type":"method","Syntax":{"content":"Task UnloadSceneAsync(string sceneName)","parameters":[{"id":"sceneName","type":"System.String"}],"return":{"type":"Task"},"content.vb":"Function UnloadSceneAsync(sceneName As String) As Task"},"File":"api/GameFramework.Services.Interfaces.ISceneService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.ISceneService.GetCurrentSceneName","Type":"method","Syntax":{"content":"string GetCurrentSceneName()","return":{"type":"System.String"},"content.vb":"Function GetCurrentSceneName As String"},"File":"api/GameFramework.Services.Interfaces.ISceneService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.ISceneService.IsSceneLoaded(System.String)","Type":"method","Syntax":{"content":"bool IsSceneLoaded(string sceneName)","parameters":[{"id":"sceneName","type":"System.String"}],"return":{"type":"System.Boolean"},"content.vb":"Function IsSceneLoaded(sceneName As String) As Boolean"},"File":"api/GameFramework.Services.Interfaces.ISceneService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement","Summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Custom UI element that renders a simple line graph for performance metrics</p>\n<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Design:</p>\n<ul sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Uses Unity&apos;s MeshGenerationContext for efficient rendering</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Circular buffer for memory-efficient data storage</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Configurable colors, ranges, and smoothing</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Auto-scaling based on data range</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Pros:</p>\n<ul sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"14\">\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Efficient rendering using Unity&apos;s native mesh generation</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">Memory efficient with fixed-size circular buffer</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Smooth visual updates with configurable sampling</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">Auto-scaling prevents data clipping</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"16\" sourceendlinenumber=\"16\">Cons:</p>\n<ul sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"17\" sourceendlinenumber=\"19\">\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"17\" sourceendlinenumber=\"17\">Custom rendering adds complexity</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"18\" sourceendlinenumber=\"18\">Limited to simple line graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"19\" sourceendlinenumber=\"19\">Requires manual styling integration</li>\n</ul>\n","Type":"class","Syntax":{"content":"public class GraphElement : VisualElement","content.vb":"Public Class GraphElement\n    Inherits VisualElement"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.MaxDataPoints","Type":"property","Syntax":{"content":"public int MaxDataPoints { get; }","parameters":[],"return":{"type":"System.Int32"},"content.vb":"Public ReadOnly Property MaxDataPoints As Integer"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.MinDisplayValue","Type":"property","Syntax":{"content":"public float MinDisplayValue { get; }","parameters":[],"return":{"type":"System.Single"},"content.vb":"Public ReadOnly Property MinDisplayValue As Single"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.MaxDisplayValue","Type":"property","Syntax":{"content":"public float MaxDisplayValue { get; }","parameters":[],"return":{"type":"System.Single"},"content.vb":"Public ReadOnly Property MaxDisplayValue As Single"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.#ctor(System.Int32)","Type":"constructor","Syntax":{"content":"public GraphElement(int maxDataPoints = 60)","parameters":[{"id":"maxDataPoints","type":"System.Int32"}],"content.vb":"Public Sub New(maxDataPoints As Integer = 60)"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.AddDataPoint(System.Single)","Summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Add a new data point to the graph</p>\n","Type":"method","Syntax":{"content":"public void AddDataPoint(float value)","parameters":[{"id":"value","type":"System.Single"}],"content.vb":"Public Sub AddDataPoint(value As Single)"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Add a new data point to the graph</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.SetLineColor(Color)","Summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set the line color for the graph</p>\n","Type":"method","Syntax":{"content":"public void SetLineColor(Color color)","parameters":[{"id":"color","type":"Color"}],"content.vb":"Public Sub SetLineColor(color As Color)"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set the line color for the graph</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.SetFixedScale(System.Single,System.Single)","Summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set fixed scale range (disables auto-scaling)</p>\n","Type":"method","Syntax":{"content":"public void SetFixedScale(float minValue, float maxValue)","parameters":[{"id":"minValue","type":"System.Single"},{"id":"maxValue","type":"System.Single"}],"content.vb":"Public Sub SetFixedScale(minValue As Single, maxValue As Single)"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set fixed scale range (disables auto-scaling)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.EnableAutoScale","Summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Enable auto-scaling based on data range</p>\n","Type":"method","Syntax":{"content":"public void EnableAutoScale()","content.vb":"Public Sub EnableAutoScale"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Enable auto-scaling based on data range</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities.GraphElement.Clear","Summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Clear all data points</p>\n","Type":"method","Syntax":{"content":"public void Clear()","content.vb":"Public Sub Clear"},"File":"api/GameFramework.UI.Utilities.GraphElement.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Utilities.GraphElement.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Clear all data points</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests","Type":"namespace","File":"api/GameFramework.Tests.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.PausePopup","Summary":"<p sourcefile=\"api/GameFramework.UI.Popups.PausePopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Pause popup UI that handles pause menu interactions as an overlay\nProvides options to resume, load game, access options, or return to main menu\nWorks within PlayingState rather than as a separate state</p>\n","Type":"class","Syntax":{"content":"public class PausePopup : UIPopup","content.vb":"Public Class PausePopup\n    Inherits UIPopup"},"File":"api/GameFramework.UI.Popups.PausePopup.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.PausePopup.#ctor(VisualElement)","Type":"constructor","Syntax":{"content":"public PausePopup(VisualElement rootElement)","parameters":[{"id":"rootElement","type":"VisualElement"}],"content.vb":"Public Sub New(rootElement As VisualElement)"},"File":"api/GameFramework.UI.Popups.PausePopup.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.PausePopup.OnShow","Type":"method","Syntax":{"content":"protected override async vo