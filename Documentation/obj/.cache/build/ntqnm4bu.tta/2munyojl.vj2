Input.InputManager.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Unified Input Manager - handles both Unity Input System integration AND input handler management\nReplaces both InputService and the old InputManager concept</p>\n","Type":"class","Syntax":{"content":"public class InputManager : IInputManager","content.vb":"Public Class InputManager\n    Inherits IInputManager"},"File":"api/GameFramework.Input.InputManager.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Input.InputManager.IsInitialized","Type":"property","Syntax":{"content":"public bool IsInitialized { get; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public ReadOnly Property IsInitialized As Boolean"},"File":"api/GameFramework.Input.InputManager.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Input.InputManager.#ctor(IEventSystem,ConsoleInputHandler,UIInputHandler,PlayerInputHandler)","Type":"constructor","Syntax":{"content":"public InputManager(IEventSystem eventSystem, ConsoleInputHandler consoleHandler, UIInputHandler uiHandler, PlayerInputHandler playerHandler)","parameters":[{"id":"eventSystem","type":"IEventSystem"},{"id":"consoleHandler","type":"ConsoleInputHandler"},{"id":"uiHandler","type":"UIInputHandler"},{"id":"playerHandler","type":"PlayerInputHandler"}],"content.vb":"Public Sub New(eventSystem As IEventSystem, consoleHandler As ConsoleInputHandler, uiHandler As UIInputHandler, playerHandler As PlayerInputHandler)"},"File":"api/GameFramework.Input.InputManager.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Input.InputManager.InitializeAsync","Type":"method","Syntax":{"content":"public async Task InitializeAsync()","return":{"type":"Task"},"content.vb":"Public Function InitializeAsync As Task"},"File":"api/GameFramework.Input.InputManager.yml","Meta