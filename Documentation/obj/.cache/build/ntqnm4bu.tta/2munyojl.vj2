tion(sceneName As String, transitionData As Dictionary(Of String, Object) = Nothing) As LoadingConfiguration"},"File":"api/GameFramework.StateMachine.Data.LoadingConfiguration.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService","Type":"interface","Syntax":{"content":"public interface IConsoleService : IGameService","content.vb":"Public Interface IConsoleService\n    Inherits IGameService"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService.InitializeAsync","Type":"method","Syntax":{"content":"Task InitializeAsync()","return":{"type":"Task"},"content.vb":"Function InitializeAsync As Task"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService.Shutdown","Type":"method","Syntax":{"content":"void Shutdown()","content.vb":"Sub Shutdown"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService.IsConsoleOpen","Type":"method","Syntax":{"content":"bool IsConsoleOpen()","return":{"type":"System.Boolean"},"content.vb":"Function IsConsoleOpen As Boolean"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService.SetConsoleOpen(System.Boolean)","Type":"method","Syntax":{"content":"void SetConsoleOpen(bool open)","parameters":[{"id":"open","type":"System.Boolean"}],"content.vb":"Sub SetConsoleOpen(open As Boolean)"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService.ExecuteCommand(System.String)","Type":"method","Syntax":{"content":"void ExecuteCommand(string command)","parameters":[{"id":"command","type":"System.String"}],"content.vb":"Sub ExecuteCommand(command As String)"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.Interfaces.IConsoleService.WriteLine(System.String)","Type":"method","Syntax":{"content":"void WriteLine(string message)","parameters":[{"id":"message","type":"System.String"}],"content.vb":"Sub WriteLine(message As String)"},"File":"api/GameFramework.Services.Interfaces.IConsoleService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen","Summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Base class for all UI screens with optional frame update support\nFrame updates are managed centrally by UIService for performance</p>\n","Type":"class","Syntax":{"content":"public abstract class UIScreen","content.vb":"Public MustInherit Class UIScreen"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.RootElement","Type":"property","Syntax":{"content":"protected VisualElement RootElement { get; }","parameters":[],"return":{"type":"VisualElement"},"content.vb":"Protected ReadOnly Property RootElement As VisualElement"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.IsVisible","Type":"property","Syntax":{"content":"public bool IsVisible { get; protected set; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public Property IsVisible As Boolean"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.NeedsFrameUpdates","Type":"property","Syntax":{"content":"public bool NeedsFrameUpdates { get; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public ReadOnly Property NeedsFrameUpdates As Boolean"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen._eventSystem","Type":"field","Syntax":{"content":"protected IEventSystem _eventSystem","return":{"type":"IEventSystem"},"content.vb":"Protected _eventSystem As IEventSystem"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.#ctor(VisualElement)","Type":"constructor","Syntax":{"content":"protected UIScreen(VisualElement rootElement)","parameters":[{"id":"rootElement","type":"VisualElement"}],"content.vb":"Protected Sub New(rootElement As VisualElement)"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.Show","Type":"method","Syntax":{"content":"public virtual void Show()","content.vb":"Public Overridable Sub Show"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.Hide","Type":"method","Syntax":{"content":"public virtual void Hide()","content.vb":"Public Overridable Sub Hide"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.EnableFrameUpdates","Summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Call this in derived constructors if the screen needs frame updates\nThis will register the screen with UIService for centralized updates</p>\n","Type":"method","Syntax":{"content":"protected void EnableFrameUpdates()","content.vb":"Protected Sub EnableFrameUpdates"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Call this in derived constructors if the screen needs frame updates\nThis will register the screen with UIService for centralized updates</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.DisableFrameUpdates","Summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Disable frame updates for this screen</p>\n","Type":"method","Syntax":{"content":"protected void DisableFrameUpdates()","content.vb":"Protected Sub DisableFrameUpdates"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Disable frame updates for this screen</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.OnUpdate(System.Single)","Summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Override this for frame-based updates (only called when screen is visible and needs updates)</p>\n","Type":"method","Syntax":{"content":"protected virtual void OnUpdate(float deltaTime)","parameters":[{"id":"deltaTime","type":"System.Single"}],"content.vb":"Protected Overridable Sub OnUpdate(deltaTime As Single)"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Override this for frame-based updates (only called when screen is visible and needs updates)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.OnShow","Type":"method","Syntax":{"content":"protected virtual void OnShow()","content.vb":"Protected Overridable Sub OnShow"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.OnHide","Type":"method","Syntax":{"content":"protected virtual void OnHide()","content.vb":"Protected Overridable Sub OnHide"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.Cleanup","Summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Clean up when screen is destroyed</p>\n","Type":"method","Syntax":{"content":"public virtual void Cleanup()","content.vb":"Public Overridable Sub Cleanup"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Clean up when screen is destroyed</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.UIScreen.ShouldUpdateWhenPaused","Summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Override this to specify if this screen should update even when the game is paused\nMost screens should not update when paused, but some (like pause menus) might need to</p>\n","Type":"method","Syntax":{"content":"public virtual bool ShouldUpdateWhenPaused()","return":{"type":"System.Boolean"},"content.vb":"Public Overridable Function ShouldUpdateWhenPaused As Boolean"},"File":"api/GameFramework.UI.UIScreen.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.UIScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Override this to specify if this screen should update even when the game is paused\nMost screens should not update when paused, but some (like pause menus) might need to</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer","Summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Enhanced dependency injection container with automatic constructor injection support.\nSupports singleton registration, factory registration, type bindings, and automatic dependency resolution.</p>\n<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"7\">Design: Service container with constructor injection and dependency graph resolution\nPros: Clean separation of concerns, automatic dependency resolution, easy testing, loose coupling\nCons: Runtime dependency resolution, potential circular dependencies, reflection overhead</p>\n","Type":"class","Syntax":{"content":"public class DIContainer","content.vb":"Public Class DIContainer"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer.Instance","Type":"property","Syntax":{"content":"public static DIContainer Instance { get; }","parameters":[],"return":{"type":"GameFramework.Core.DIContainer"},"content.vb":"Public Shared ReadOnly Property Instance As DIContainer"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer.RegisterSingleton``1(``0)","Summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a singleton instance that will be reused for all requests</p>\n","Type":"method","Syntax":{"content":"public void RegisterSingleton<T>(T instance)\n    where T : class","parameters":[{"id":"instance","type":"{T}"}],"typeParameters":[{"id":"T"}],"content.vb":"Public Sub RegisterSingleton(Of T As Class)(instance As T)"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a singleton instance that will be reused for all requests</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer.RegisterSingleton``2","Summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a singleton by type - will be created on first request</p>\n","Type":"method","Syntax":{"content":"public void RegisterSingleton<TInterface, TImplementation>()\n    where TImplementation : class, TInterface","typeParameters":[{"id":"TInterface"},{"id":"TImplementation"}],"content.vb":"Public Sub RegisterSingleton(Of TInterface, TImplementation As {Class, TInterface})"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a singleton by type - will be created on first request</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer.RegisterSingleton``1","Summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a singleton by type</p>\n","Type":"method","Syntax":{"content":"public void RegisterSingleton<T>()\n    where T : class","typeParameters":[{"id":"T"}],"content.vb":"Public Sub RegisterSingleton(Of T As Class)"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a singleton by type</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer.RegisterFactory``1(Func{``0})","Summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a factory function that creates new instances on each request</p>\n","Type":"method","Syntax":{"content":"public void RegisterFactory<T>(Func<T> factory)\n    where T : class","parameters":[{"id":"factory","type":"Func{{T}}"}],"typeParameters":[{"id":"T"}],"content.vb":"Public Sub RegisterFactory(Of T As Class)(factory As Func(Of T))"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a factory function that creates new instances on each request</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Core.DIContainer.RegisterTransient``2","Summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Register a transient type binding - new instance created each time</p>\n","Type":"method","Syntax":{"content":"public void RegisterTransient<TInterface, TImplementation>()\n    where TImplementation : class, TInterface","typeParameters":[{"id":"TInterface"},{"id":"TImplementation"}],"content.vb":"Public Sub RegisterTransient(Of TInterface, TImplementation As {Class, TInterface})"},"File":"api/GameFramework.Core.DIContainer.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Core.DIContainer.yml\" sourcest