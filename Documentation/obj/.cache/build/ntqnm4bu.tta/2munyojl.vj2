,"parameters":[{"id":"saveName","type":"System.String"}],"return":{"type":"Task{System.Boolean}"},"content.vb":"Public Function LoadSessionAsync(saveName As String) As Task(Of Boolean)"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Loads a session from save file using SaveService</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.LoadSessionAsync(SaveFileInfo)","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Loads a session using SaveFileInfo from SaveService</p>\n","Type":"method","Syntax":{"content":"public async Task<bool> LoadSessionAsync(SaveFileInfo saveFileInfo)","parameters":[{"id":"saveFileInfo","type":"SaveFileInfo"}],"return":{"type":"Task{System.Boolean}"},"content.vb":"Public Function LoadSessionAsync(saveFileInfo As SaveFileInfo) As Task(Of Boolean)"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Loads a session using SaveFileInfo from SaveService</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.GetPlayerState","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets the current player state - throws if no active session</p>\n","Type":"method","Syntax":{"content":"public PlayerState GetPlayerState()","return":{"type":"PlayerState"},"content.vb":"Public Function GetPlayerState As PlayerState"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets the current player state - throws if no active session</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.GetGameProgress","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets the current game progress - throws if no active session  </p>\n","Type":"method","Syntax":{"content":"public GameProgress GetGameProgress()","return":{"type":"GameProgress"},"content.vb":"Public Function GetGameProgress As GameProgress"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets the current game progress - throws if no active session  </p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.GetCustomData``1(System.String,``0)","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets custom data from current session</p>\n","Type":"method","Syntax":{"content":"public T GetCustomData<T>(string key, T defaultValue = null)","parameters":[{"id":"key","type":"System.String"},{"id":"defaultValue","type":"{T}"}],"typeParameters":[{"id":"T"}],"return":{"type":"{T}"},"content.vb":"Public Function GetCustomData(Of T)(key As String, defaultValue As T = Nothing) As T"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets custom data from current session</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.SetCustomData``1(System.String,``0)","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Sets custom data in current session</p>\n","Type":"method","Syntax":{"content":"public void SetCustomData<T>(string key, T value)","parameters":[{"id":"key","type":"System.String"},{"id":"value","type":"{T}"}],"typeParameters":[{"id":"T"}],"content.vb":"Public Sub SetCustomData(Of T)(key As String, value As T)"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Sets custom data in current session</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.HasActiveSession","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if there&apos;s an active game session</p>\n","Type":"method","Syntax":{"content":"public bool HasActiveSession()","return":{"type":"System.Boolean"},"content.vb":"Public Function HasActiveSession As Boolean"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if there&apos;s an active game session</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.GetLoadingData``1(System.String,``0)","Summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets loading configuration data</p>\n","Type":"method","Syntax":{"content":"public T GetLoadingData<T>(string key, T defaultValue = null)","parameters":[{"id":"key","type":"System.String"},{"id":"defaultValue","type":"{T}"}],"typeParameters":[{"id":"T"}],"return":{"type":"{T}"},"content.vb":"Public Function GetLoadingData(Of T)(key As String, defaultValue As T = Nothing) As T"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.GameDataService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Gets loading configuration data</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Core console system that manages command execution, history, and output.</p>\n<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Architecture:</p>\n<ul sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Static class for global access (consider making non-static in future for better testability)</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Manages command queue, history, and execution</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Delegates UI operations to registered IConsoleUI implementation</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Thread-safe command queuing for commands from other threads</li>\n</ul>\n<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Command Execution Flow:</p>\n<ol sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"14\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Commands are queued via EnqueueCommand()</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">ConsoleUpdate() processes the queue each frame</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Commands are tokenized and looked up in registry</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">Command execution results are output to console</li>\n</ol>\n","Type":"class","Syntax":{"content":"public static class Console","content.vb":"Public Module Console"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.s_PendingCommandsWaitForFrames","Type":"field","Syntax":{"content":"public static int s_PendingCommandsWaitForFrames","return":{"type":"System.Int32"},"content.vb":"Public Shared s_PendingCommandsWaitForFrames As Integer"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.s_PendingCommandsWaitForLoad","Type":"field","Syntax":{"content":"public static bool s_PendingCommandsWaitForLoad","return":{"type":"System.Boolean"},"content.vb":"Public Shared s_PendingCommandsWaitForLoad As Boolean"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.Init(GameFramework.ConsoleTool.IConsoleUI)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Initialize the console system with a UI implementation</p>\n","Type":"method","Syntax":{"content":"public static void Init(IConsoleUI consoleUI)","parameters":[{"id":"consoleUI","type":"GameFramework.ConsoleTool.IConsoleUI","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">UI implementation to use for console display</p>\n"}],"content.vb":"Public Shared Sub Init(consoleUI As IConsoleUI)"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Initialize the console system with a UI implementation</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.Shutdown","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Shutdown the console system</p>\n","Type":"method","Syntax":{"content":"public static void Shutdown()","content.vb":"Public Shared Sub Shutdown"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Shutdown the console system</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.Write(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Write a message to the console output</p>\n","Type":"method","Syntax":{"content":"public static void Write(string message)","parameters":[{"id":"message","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Message to display</p>\n"}],"content.vb":"Public Shared Sub Write(message As String)"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Write a message to the console output</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.IsOpen","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Check if console is currently open/visible</p>\n","Type":"method","Syntax":{"content":"public static bool IsOpen()","return":{"type":"System.Boolean"},"content.vb":"Public Shared Function IsOpen As Boolean"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Check if console is currently open/visible</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.SetOpen(System.Boolean)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set console open/closed state</p>\n","Type":"method","Syntax":{"content":"public static void SetOpen(bool open)","parameters":[{"id":"open","type":"System.Boolean"}],"content.vb":"Public Shared Sub SetOpen(open As Boolean)"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set console open/closed state</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.SetPrompt(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set the console prompt text</p>\n","Type":"method","Syntax":{"content":"public static void SetPrompt(string prompt)","parameters":[{"id":"prompt","type":"System.String"}],"content.vb":"Public Shared Sub SetPrompt(prompt As String)"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Set the console prompt text</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.EnqueueCommand(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Add a command to the execution queue with history tracking\nThread-safe for commands from other threads</p>\n","Type":"method","Syntax":{"content":"public static void EnqueueCommand(string command)","parameters":[{"id":"command","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Command string to execute</p>\n"}],"content.vb":"Public Shared Sub EnqueueCommand(command As String)"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Add a command to the execution queue with history tracking\nThread-safe for commands from other threads</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.EnqueueCommandNoHistory(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Add a command to execution queue without adding to history\nUseful for programmatic commands that shouldn&apos;t appear in user history</p>\n","Type":"method","Syntax":{"content":"public static void EnqueueCommandNoHistory(string command)","parameters":[{"id":"command","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Command string to execute</p>\n"}],"content.vb":"Public Shared Sub EnqueueCommandNoHistory(command As String)"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Add a command to execution queue without adding to history\nUseful for programmatic commands that shouldn&apos;t appear in user history</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.ConsoleUpdate","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Process pending commands and update console UI\nShould be called every frame by ConsoleService</p>\n","Type":"method","Syntax":{"content":"public static void ConsoleUpdate()","content.vb":"Public Shared Sub ConsoleUpdate"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Process pending commands and update console UI\nShould be called every frame by ConsoleService</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.ConsoleLateUpdate","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Late update for console UI\nShould be called every frame by ConsoleService</p>\n","Type":"method","Syntax":{"content":"public static void ConsoleLateUpdate()","content.vb":"Public Shared Sub ConsoleLateUpdate"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Late update for console UI\nShould be called every frame by ConsoleService</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.HistoryUp(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Get previous command from history</p>\n","Type":"method","Syntax":{"content":"public static string HistoryUp(string current)","parameters":[{"id":"current","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Current input text (stored if at end of history)</p>\n"}],"return":{"type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Previous command or empty string if at beginning</p>\n"},"content.vb":"Public Shared Function HistoryUp(current As String) As String"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Get previous command from history</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.HistoryDown","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Get next command from history</p>\n","Type":"method","Syntax":{"content":"public static string HistoryDown()","return":{"type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Next command or empty string if at end</p>\n"},"content.vb":"Public Shared Function HistoryDown As String"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Get next command from history</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Console.TabComplete(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Perform tab completion on a partial command</p>\n","Type":"method","Syntax":{"content":"public static string TabComplete(string prefix)","parameters":[{"id":"prefix","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Partial command to complete</p>\n"}],"return":{"type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Completed command or original if no matches</p>\n"},"content.vb":"Public Shared Function TabComplete(prefix As String) As String"},"File":"api/GameFramework.ConsoleTool.Console.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Console.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Perform tab completion on a partial command</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.UI.UIElementValidator.ValidationMode","Type":"enum","Syntax":{"content":"public enum ValidationMode","content.vb":"Public Enum ValidationMode"},"File":"api/UCTools_Utilities.UI.UIElementValidator.ValidationMode.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.UI.UIElementValidator.ValidationMode.LogWarnings","Type":"field","Syntax":{"content":"LogWarnings = 0","return":{"type":"UCTools_Utilities.UI.UIElementValidator.ValidationMode"}},"File":"api/UCTools_Utilities.UI.UIElementValidator.ValidationMode.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.UI.UIElementValidator.ValidationMode.ThrowExceptions","Type":"field","Syntax":{"content":"ThrowExceptions = 1","return":{"type":"UCTools_Utilities.UI.UIElementValidator.ValidationMode"}},"File":"api/UCTools_Utilities.UI.UIElementValidator.ValidationMode.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.UI.UIElementValidator.ValidationMode.Silent","Type":"field","Syntax":{"content":"Silent = 2","return":{"type":"UCTools_Utilities.UI.UIElementValidator.ValidationMode"}},"File":"api/UCTools_Utilities.UI.UIElementValidator.ValidationMode.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Implementation of console context that provides safe access to console functionality\nActs as a facade to prevent commands from directly accessing console internals</p>\n","Type":"class","Syntax":{"content":"public class ConsoleContext : IConsoleContext","content.vb":"Public Class ConsoleContext\n    Implements IConsoleContext"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.WriteLine(System.String)","Type":"method","Syntax":{"content":"public void WriteLine(string message)","parameters":[{"id":"message","type":"System.String"}],"content.vb":"Public Sub WriteLine(message As String)"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.WriteError(System.String)","Type":"method","Syntax":{"content":"public void WriteError(string message)","parameters":[{"id":"message","type":"System.String"}],"content.vb":"Public Sub WriteError(message As String)"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.WriteWarning(System.String)","Type":"method","Syntax":{"content":"public void WriteWarning(string message)","parameters":[{"id":"message","type":"System.String"}],"content.vb":"Public Sub WriteWarning(message As String)"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.EnqueueCommand(System.String)","Type":"method","Syntax":{"content":"public void EnqueueCommand(string command)","parameters":[{"id":"command","type":"System.String"}],"content.vb":"Public Sub EnqueueCommand(command As String)"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.SetWaitFrames(System.Int32)","Type":"method","Syntax":{"content":"public void SetWaitFrames(int frames)","parameters":[{"id":"frames","type":"System.Int32"}],"content.vb":"Public Sub SetWaitFrames(frames As Integer)"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.SetWaitForLoad(System.Boolean)","Type":"method","Syntax":{"content":"public void SetWaitForLoad(bool wait)","parameters":[{"id":"wait","type":"System.Boolean"}],"content.vb":"Public Sub SetWaitForLoad(wait As Boolean)"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleContext.IsCommandRegistered(System.String)","Type":"method","Syntax":{"content":"public bool IsCommandRegistered(string commandName)","parameters":[{"id":"commandName","type":"System.String"}],"return":{"type":"System.Boolean"},"content.vb":"Public Function IsCommandRegistered(commandName As String) As Boolean"},"File":"api/GameFramework.ConsoleTool.ConsoleContext.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests.HelperClasses.UI.GameFramework.Tests.Services.TestUIScreen","Type":"class","Syntax":{"content":"public class TestUIScreen : UIScreen","content.vb":"Public Class TestUIScreen\n    Inherits UIScreen"},"File":"api/GameFramework.Tests.HelperClasses.UI.GameFramework.Tests.Services.TestUIScreen.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests.HelperClasses.UI.GameFramework.Tests.Services.TestUIScreen.#ctor(VisualElement)","Type":"constructor","Syntax":{"content":"public TestUIScreen(VisualElement rootElement)","parameters":[{"id":"rootElement","type":"VisualElement"}],"content.vb":"Public Sub New(rootElement As VisualElement)"},"File":"api/GameFramework.Tests.HelperClasses.UI.GameFramework.Tests.Services.TestUIScreen.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Abstract base class for all typed configuration variables</p>\n","Type":"class","Syntax":{"content":"[Serializable]\npublic abstract class ConfigVariableBase","content.vb":"<Serializable>\nPublic MustInherit Class ConfigVariableBase"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.name","Type":"field","Syntax":{"content":"public string name","return":{"type":"System.String"},"content.vb":"Public name As String"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.description","Type":"field","Syntax":{"content":"public string description","return":{"type":"System.String"},"content.vb":"Public description As String"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.flags","Type":"field","Syntax":{"content":"public ConfigFlags flags","return":{"type":"UCTools_ConfigVariables.ConfigFlags"},"content.vb":"Public flags As ConfigFlags"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.ValueType","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Variable type for runtime identification</p>\n","Type":"property","Syntax":{"content":"public abstract Type ValueType { get; }","parameters":[],"return":{"type":"Type"},"content.vb":"Public MustOverride ReadOnly Property ValueType As Type"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Variable type for runtime identification</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.ChangeCheck","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Check if the variable has been modified since the last call to ChangeCheck()</p>\n","Type":"method","Syntax":{"content":"public bool ChangeCheck()","return":{"type":"System.Boolean"},"content.vb":"Public Function ChangeCheck As Boolean"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Check if the variable has been modified since the last call to ChangeCheck()</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.MarkChanged","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Mark variable as changed</p>\n","Type":"method","Syntax":{"content":"protected void MarkChanged()","content.vb":"Protected Sub MarkChanged"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Mark variable as changed</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.ResetToDefault","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Reset to default value</p>\n","Type":"method","Syntax":{"content":"public abstract void ResetToDefault()","content.vb":"Public MustOverride Sub ResetToDefault"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Reset to default value</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.ValidateConfiguration(System.String@)","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Validate the configuration variable setup</p>\n","Type":"method","Syntax":{"content":"public abstract bool ValidateConfiguration(out string error)","parameters":[{"id":"error","type":"System.String"}],"return":{"type":"System.Boolean"},"content.vb":"Public MustOverride Function ValidateConfiguration(ByRef error As String) As Boolean"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Validate the configuration variable setup</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.GetValueAsObject","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Get value as object (for generic access)</p>\n","Type":"method","Syntax":{"content":"public abstract object GetValueAsObject()","return":{"type":"System.Object"},"content.vb":"Public MustOverride Function GetValueAsObject As Object"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Get value as object (for generic access)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.SetValueFromObject(System.Object)","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Set value from object (for generic access)</p>\n","Type":"method","Syntax":{"content":"public abstract bool SetValueFromObject(object value)","parameters":[{"id":"value","type":"System.Object"}],"return":{"type":"System.Boolean"},"content.vb":"Public MustOverride Function SetValueFromObject(value As Object) As Boolean"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Set value from object (for generic access)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.GetValueAsString","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Get value as string (for serialization)</p>\n","Type":"method","Syntax":{"content":"public abstract string GetValueAsString()","return":{"type":"System.String"},"content.vb":"Public MustOverride Function GetValueAsString As String"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Get value as string (for serialization)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigVariableBase.SetValueFromString(System.String)","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Set value from string (for deserialization)</p>\n","Type":"method","Syntax":{"content":"public abstract bool SetValueFromString(string value)","parameters":[{"id":"value","type":"System.String"}],"return":{"type":"System.Boolean"},"content.vb":"Public MustOverride Function SetValueFromString(value As String) As Boolean"},"File":"api/UCTools_ConfigVariables.ConfigVariableBase.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigVariableBase.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Set value from string (for deserialization)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Behavioral flags that control how configuration variables are handled\nCan be combined using bitwise OR to give variables multiple behaviors</p>\n<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Usage Examples:</p>\n<ul sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Flags.Save: Variable persists between sessions</li>\n<li sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Flags.Save | Flags.ServerInfo: Variable persists AND is sent to clients</li>\n<li sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Flags.Cheat: Variable can only be modified when cheats are enabled</li>\n</ul>\n","Type":"enum","Syntax":{"content":"public enum ConfigFlags","content.vb":"Public Enum ConfigFlags"},"File":"api/UCTools_ConfigVariables.ConfigFlags.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags.None","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Default behavior - temporary variable, not saved or replicated</p>\n","Type":"field","Syntax":{"content":"None = 0","return":{"type":"UCTools_ConfigVariables.ConfigFlags"}},"File":"api/UCTools_ConfigVariables.ConfigFlags.yml","Metadata":{"type":"field","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Default behavior - temporary variable, not saved or replicated</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags.Save","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable should be saved to configuration file and loaded on startup\nUsed for user preferences, graphics settings, key bindings, etc.\nTriggers file I/O operations when modified</p>\n","Type":"field","Syntax":{"content":"Save = 1","return":{"type":"UCTools_ConfigVariables.ConfigFlags"}},"File":"api/UCTools_ConfigVariables.ConfigFlags.yml","Metadata":{"type":"field","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable should be saved to configuration file and loaded on startup\nUsed for user preferences, graphics settings, key bindings, etc.\nTriggers file I/O operations when modified</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags.Cheat","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable is considered a cheat and can only be modified when cheats are enabled\nUsed for debug variables, god mode, infinite resources, etc.\nProvides protection against accidental or unauthorized modifications</p>\n","Type":"field","Syntax":{"content":"Cheat = 2","return":{"type":"UCTools_ConfigVariables.ConfigFlags"}},"File":"api/UCTools_ConfigVariables.ConfigFlags.yml","Metadata":{"type":"field","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable is considered a cheat and can only be modified when cheats are enabled\nUsed for debug variables, god mode, infinite resources, etc.\nProvides protection against accidental or unauthorized modifications</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags.ServerInfo","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable is sent from server to clients when they connect or when value changes\nUsed for server settings that affect gameplay: time limits, player counts, etc.\nEnsures all clients have consistent server configuration</p>\n","Type":"field","Syntax":{"content":"ServerInfo = 4","return":{"type":"UCTools_ConfigVariables.ConfigFlags"}},"File":"api/UCTools_ConfigVariables.ConfigFlags.yml","Metadata":{"type":"field","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable is sent from server to clients when they connect or when value changes\nUsed for server settings that affect gameplay: time limits, player counts, etc.\nEnsures all clients have consistent server configuration</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags.ClientInfo","Summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable is sent from client to server when connecting or when value changes\nUsed for client preferences that server needs to know: preferred name, color, etc.\nAllows server to customize experience based on client preferences</p>\n","Type":"field","Syntax":{"content":"ClientInfo = 8","return":{"type":"UCTools_ConfigVariables.ConfigFlags"}},"File":"api/UCTools_ConfigVariables.ConfigFlags.yml","Metadata":{"type":"field","summary":"<p sourcefile=\"api/UCTools_ConfigVariables.ConfigFlags.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Variable is sent from client to server when connecting or when value changes\nUsed for client preferences that server needs to know: preferred name, color, etc.\nAllows server to customize experience based on client preferences</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_ConfigVariables.ConfigFlags.User","Summary":"<p so