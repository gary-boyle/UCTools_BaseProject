                 - Creates a cube at origin (0,0,0)\nspawn sphere             - Creates a sphere at origin\nspawn cube 5 10 0        - Creates a cube at position (5, 10, 0)\nspawn cylinder 0 5 0 red - Creates a red cylinder at (0, 5, 0)</p>\n</blockquote>\n<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"12\">This serves as a template for creating your own console commands\nCopy this file and modify it to create new functionality</p>\n","Type":"class","Syntax":{"content":"public class ExampleCommand : ConsoleCommandBase, IConsoleCommand","content.vb":"Public Class ExampleCommand\n    Inherits ConsoleCommandBase\n    Implements IConsoleCommand"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.CommandName","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">The name users type to execute this command (case-insensitive)\nKeep it short and memorable - this is what users will type in the console</p>\n","Type":"property","Syntax":{"content":"public override string CommandName { get; }","parameters":[],"return":{"type":"System.String"},"content.vb":"Public Overrides ReadOnly Property CommandName As String"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">The name users type to execute this command (case-insensitive)\nKeep it short and memorable - this is what users will type in the console</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.Description","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Brief description shown in help command\nShould be concise but descriptive enough to understand the command&apos;s purpose</p>\n","Type":"property","Syntax":{"content":"public override string Description { get; }","parameters":[],"return":{"type":"System.String"},"content.vb":"Public Overrides ReadOnly Property Description As String"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Brief description shown in help command\nShould be concise but descriptive enough to understand the command&apos;s purpose</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.Category","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Category for organizing commands in help display\nCommon categories: &quot;System&quot;, &quot;Debug&quot;, &quot;Game&quot;, &quot;Testing&quot;, &quot;Development&quot;</p>\n","Type":"property","Syntax":{"content":"public override CategoryEnum Category { get; }","parameters":[],"return":{"type":"CategoryEnum"},"content.vb":"Public Overrides ReadOnly Property Category As CategoryEnum"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Category for organizing commands in help display\nCommon categories: &quot;System&quot;, &quot;Debug&quot;, &quot;Game&quot;, &quot;Testing&quot;, &quot;Development&quot;</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.Tag","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Tag for bulk operations (optional - use 0 if not needed)\nUseful for removing groups of related commands (e.g., all debug commands)</p>\n","Type":"property","Syntax":{"content":"public override int Tag { get; }","parameters":[],"return":{"type":"System.Int32"},"content.vb":"Public Overrides ReadOnly Property Tag As Integer"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Tag for bulk operations (optional - use 0 if not needed)\nUseful for removing groups of related commands (e.g., all debug commands)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.Execute(System.String[],GameFramework.ConsoleTool.IConsoleContext)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Main command execution method - this is called when user runs the command\nParse arguments and perform the requested action\nAlways validate input and provide helpful error messages</p>\n","Type":"method","Syntax":{"content":"public override void Execute(string[] args, IConsoleContext context)","parameters":[{"id":"args","type":"System.String[]","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Command arguments (everything after the command name)</p>\n"},{"id":"context","type":"GameFramework.ConsoleTool.IConsoleContext","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Console context for output and system interaction</p>\n"}],"content.vb":"Public Overrides Sub Execute(args As String(), context As IConsoleContext)"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Main command execution method - this is called when user runs the command\nParse arguments and perform the requested action\nAlways validate input and provide helpful error messages</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.GetUsage","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Provide detailed usage information for the help system\nShould include all possible argument combinations with examples</p>\n","Type":"method","Syntax":{"content":"public override string GetUsage()","return":{"type":"System.String"},"content.vb":"Public Overrides Function GetUsage As String"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Provide detailed usage information for the help system\nShould include all possible argument combinations with examples</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.Commands.ExampleCommand.ValidateArgs(System.String[])","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Validate arguments before execution (optional but recommended)\nReturn false if arguments are invalid - prevents Execute() from being called</p>\n","Type":"method","Syntax":{"content":"public override bool ValidateArgs(string[] args)","parameters":[{"id":"args","type":"System.String[]"}],"return":{"type":"System.Boolean"},"content.vb":"Public Overrides Function ValidateArgs(args As String()) As Boolean"},"File":"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.Commands.ExampleCommand.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Validate arguments before execution (optional but recommended)\nReturn false if arguments are invalid - prevents Execute() from being called</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests.EventSystemTests","Summary":"<p sourcefile=\"api/GameFramework.Tests.EventSystemTests.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Comprehensive test suite for EventSystem class.\nTests event subscription, publishing, error handling, and lifecycle management.</p>\n<p sourcefile=\"api/GameFramework.Tests.EventSystemTests.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"7\">Design: Isolated tests with event handler validation\nPros: Covers all event system functionality, tests error scenarios\nCons: Async testing complexity, event handler timing considerations</p>\n","Type":"class","Syntax":{"content":"public class EventSystemTests","content.vb":"Public Class EventSystemTests"},"File":"api/GameFramework.Tests.EventSystemTests.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests.EventSystemTests.Setup","Type":"method","Syntax":{"content":"public void Setup()","content.vb":"Public Sub Setup"},"File":"api/GameFramework.Tests.EventSystemTests.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests.EventSystemTests.TearDown","Type":"method","Syntax":{"content":"public void TearDown()","content.vb":"Public Sub TearDown"},"File":"api/GameFramework.Tests.EventSystemTests.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplement