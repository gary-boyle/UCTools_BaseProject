ntSystem.Events.GameSystemsInitializedEvent.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.Singleton`1","Summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">A simple Singleton pattern implementation for MonoBehaviours.\nInherit from this class to make your MonoBehaviour a singleton.</p>\n","Type":"class","Syntax":{"content":"public abstract class Singleton<T> : MonoBehaviour where T : MonoBehaviour","typeParameters":[{"id":"T","description":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The type of the MonoBehaviour</p>\n"}],"content.vb":"Public MustInherit Class Singleton(Of T As MonoBehaviour)\n    Inherits MonoBehaviour"},"File":"api/UCTools_Utilities.Singleton-1.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.Singleton`1.Instance","Summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Global access point for this singleton.</p>\n","Type":"property","Syntax":{"content":"public static T Instance { get; }","parameters":[],"return":{"type":"{T}"},"content.vb":"Public Shared ReadOnly Property Instance As T"},"File":"api/UCTools_Utilities.Singleton-1.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Global access point for this singleton.</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.Singleton`1.Awake","Summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Called when the MonoBehaviour is created.</p>\n","Type":"method","Syntax":{"content":"protected virtual void Awake()","content.vb":"Protected Overridable Sub Awake"},"File":"api/UCTools_Utilities.Singleton-1.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Called when the MonoBehaviour is created.</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.Singleton`1.OnAwake","Summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Override this method for initialization code instead of Awake.</p>\n","Type":"method","Syntax":{"content":"protected virtual void OnAwake()","content.vb":"Protected Overridable Sub OnAwake"},"File":"api/UCTools_Utilities.Singleton-1.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_Utilities.Singleton-1.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Override this method for initialization code instead of Awake.</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Screens","Type":"namespace","File":"api/GameFramework.UI.Screens.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Tests.UI","Type":"namespace","File":"api/GameFramework.Tests.UI.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.SceneLoadedEvent","Type":"class","Syntax":{"content":"public class SceneLoadedEvent","content.vb":"Public Class SceneLoadedEvent"},"File":"api/GameFramework.EventSystem.Events.SceneLoadedEvent.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.SceneLoadedEvent.SceneName","Type":"property","Syntax":{"content":"public string SceneName { get; set; }","parameters":[],"return":{"type":"System.String"},"content.vb":"Public Property SceneName As String"},"File":"api/GameFramework.EventSystem.Events.SceneLoadedEvent.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleGUI","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Console GUI component responsible for rendering console UI and handling user input.</p>\n<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"4\" sourceendlinenumber=\"4\">Architecture:</p>\n<ul sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"8\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Pure UI component - only handles visual representation</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Subscribes to console-specific input events (not toggle - that&apos;s handled by ConsoleService)</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Uses events to communicate back to console system</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Optimized string building for better performance</li>\n</ul>\n<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"10\" sourceendlinenumber=\"10\">Input Handling Flow:</p>\n<ol sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"14\">\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">InputManager detects console input (submit, tab, history) </li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">InputManager publishes console input events</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">ConsoleGUI receives events and updates UI accordingly</li>\n<li sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">ConsoleGUI calls Console static methods to execute commands</li>\n</ol>\n","Type":"class","Syntax":{"content":"public class ConsoleGUI : MonoBehaviour, IConsoleUI","content.vb":"Public Class ConsoleGUI\n    Inherits MonoBehaviour\n    Implements IConsoleUI"},"File":"api/GameFramework.ConsoleTool.ConsoleGUI.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleGUI.Init","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Initialize the console UI</p>\n","Type":"method","Syntax":{"content":"public void Init()","content.vb":"Public Sub Init"},"File":"api/GameFramework.ConsoleTool.ConsoleGUI.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Initialize the console UI</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleGUI.Shutdown","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Shutdown the console UI</p>\n","Type":"method","Syntax":{"content":"public void Shutdown()","content.vb":"Public Sub Shutdown"},"File":"api/GameFramework.ConsoleTool.ConsoleGUI.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Shutdown the console UI</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleGUI.OutputString(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Add a line of text to the console output\nUses StringBuilder for efficient string concatenation</p>\n","Type":"method","Syntax":{"content":"public void OutputString(string message)","parameters":[{"id":"message","type":"System.String"}],"content.vb":"Public Sub OutputString(message As String)"},"File":"api/GameFramework.ConsoleTool.ConsoleGUI.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Add a line of text to the console output\nUses StringBuilder for efficient string concatenation</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleGUI.IsOpen","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Check if console is currently visible</p>\n","Type":"method","Syntax":{"content":"public bool IsOpen()","return":{"type":"System.Boolean"},"content.vb":"Public Function IsOpen As Boolean"},"File":"api/GameFramework.ConsoleTool.ConsoleGUI.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Check if console is currently visible</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.ConsoleGUI.SetOpen(System.Boolean)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Show or hide the console</p>\n","Type":"method","Syntax":{"content":"public void SetOpen(bool open)","parameters":[{"id":"open","type":"System.Boolean"}],"content.vb":"Public Sub SetOpen(open As Boolean)"},"File":"api/GameFramework.ConsoleTool.ConsoleGUI.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.ConsoleGUI.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Show or hide the console</p>\n","platform":null},"IsExp