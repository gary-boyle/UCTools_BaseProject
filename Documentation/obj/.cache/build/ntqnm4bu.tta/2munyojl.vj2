gered when the player requests to save the game</p>\n","Type":"class","Syntax":{"content":"public class SaveGameRequestedEvent","content.vb":"Public Class SaveGameRequestedEvent"},"File":"api/GameFramework.EventSystem.Events.SaveGameRequestedEvent.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.SaveGameRequestedEvent.SaveName","Type":"property","Syntax":{"content":"public string SaveName { get; set; }","parameters":[],"return":{"type":"System.String"},"content.vb":"Public Property SaveName As String"},"File":"api/GameFramework.EventSystem.Events.SaveGameRequestedEvent.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.SaveGameRequestedEvent.OverwriteExisting","Type":"property","Syntax":{"content":"public bool OverwriteExisting { get; set; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public Property OverwriteExisting As Boolean"},"File":"api/GameFramework.EventSystem.Events.SaveGameRequestedEvent.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.SaveGameRequestedEvent.#ctor(System.String,System.Boolean)","Type":"constructor","Syntax":{"content":"public SaveGameRequestedEvent(string saveName, bool overwriteExisting = false)","parameters":[{"id":"saveName","type":"System.String"},{"id":"overwriteExisting","type":"System.Boolean"}],"content.vb":"Public Sub New(saveName As String, overwriteExisting As Boolean = False)"},"File":"api/GameFramework.EventSystem.Events.SaveGameRequestedEvent.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Screens.SplashScreen","Summary":"<p sourcefile=\"api/GameFramework.UI.Screens.SplashScreen.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Splash screen implementation</p>\n","Type":"class","Syntax":{"content":"public class SplashScreen : UIScreen","content.vb":"Public Class SplashScreen\n    Inherits UIScreen"},"File":"api/GameFramework.UI.Screens.SplashScreen.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Screens.SplashScreen.#ctor(VisualElement)","Type":"constructor","Syntax":{"content":"public SplashScreen(VisualElement rootElement)","parameters":[{"id":"rootElement","type":"VisualElement"}],"content.vb":"Public Sub New(rootElement As VisualElement)"},"File":"api/GameFramework.UI.Screens.SplashScreen.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Screens.SplashScreen.OnShow","Type":"method","Syntax":{"content":"protected override void OnShow()","content.vb":"Protected Overrides Sub OnShow"},"File":"api/GameFramework.UI.Screens.SplashScreen.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Context interface providing access to console functionality\nAllows commands to interact with the console system safely without direct access to internal state\nActs as a controlled facade that prevents commands from breaking console integrity</p>\n","Type":"interface","Syntax":{"content":"public interface IConsoleContext","content.vb":"Public Interface IConsoleContext"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.WriteLine(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Writes a standard message to the console output\nMessage will be displayed in the console UI and logged to Unity&apos;s console</p>\n","Type":"method","Syntax":{"content":"void WriteLine(string message)","parameters":[{"id":"message","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The message text to display</p>\n"}],"content.vb":"Sub WriteLine(message As String)"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Writes a standard message to the console output\nMessage will be displayed in the console UI and logged to Unity&apos;s console</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.WriteError(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Writes an error message to the console output with error formatting\nTypically displayed in red or with error prefix to indicate failure</p>\n","Type":"method","Syntax":{"content":"void WriteError(string message)","parameters":[{"id":"message","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The error message to display</p>\n"}],"content.vb":"Sub WriteError(message As String)"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Writes an error message to the console output with error formatting\nTypically displayed in red or with error prefix to indicate failure</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.WriteWarning(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Writes a warning message to the console output with warning formatting\nTypically displayed in yellow or with warning prefix to indicate caution</p>\n","Type":"method","Syntax":{"content":"void WriteWarning(string message)","parameters":[{"id":"message","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The warning message to display</p>\n"}],"content.vb":"Sub WriteWarning(message As String)"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Writes a warning message to the console output with warning formatting\nTypically displayed in yellow or with warning prefix to indicate caution</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.EnqueueCommand(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Adds a command to the execution queue without adding it to command history\nUseful for batch operations, scripting, and command chaining\nCommands are executed in FIFO order during the next console update</p>\n","Type":"method","Syntax":{"content":"void EnqueueCommand(string command)","parameters":[{"id":"command","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The command string to queue (including arguments)</p>\n"}],"content.vb":"Sub EnqueueCommand(command As String)"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Adds a command to the execution queue without adding it to command history\nUseful for batch operations, scripting, and command chaining\nCommands are executed in FIFO order during the next console update</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.SetWaitFrames(System.Int32)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Sets the number of frames to wait before processing the next queued command\nUseful for timing-sensitive operations and ensuring proper frame sequencing\nCommand execution will pause until the specified number of frames have passed</p>\n","Type":"method","Syntax":{"content":"void SetWaitFrames(int frames)","parameters":[{"id":"frames","type":"System.Int32","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Number of frames to wait (must be &gt;= 0)</p>\n"}],"content.vb":"Sub SetWaitFrames(frames As Integer)"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Sets the number of frames to wait before processing the next queued command\nUseful for timing-sensitive operations and ensuring proper frame sequencing\nCommand execution will pause until the specified number of frames have passed</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.SetWaitForLoad(System.Boolean)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Sets a flag to wait for level/scene loading to complete before processing next command\nEssential for commands that depend on scene state or need to execute after scene transitions\nCommand execution will pause until the current level finishes loading</p>\n","Type":"method","Syntax":{"content":"void SetWaitForLoad(bool wait)","parameters":[{"id":"wait","type":"System.Boolean","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">True to wait for level load completion, false to continue normally</p>\n"}],"content.vb":"Sub SetWaitForLoad(wait As Boolean)"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Sets a flag to wait for level/scene loading to complete before processing next command\nEssential for commands that depend on scene state or need to execute after scene transitions\nCommand execution will pause until the current level finishes loading</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.ConsoleTool.IConsoleContext.IsCommandRegistered(System.String)","Summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Checks if a command with the specified name is currently registered in the system\nUseful for conditional command execution and validation in complex command scripts\nCommand names are case-insensitive</p>\n","Type":"method","Syntax":{"content":"bool IsCommandRegistered(string commandName)","parameters":[{"id":"commandName","type":"System.String","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The name of the command to check</p>\n"}],"return":{"type":"System.Boolean","description":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">True if the command is registered and available for execution</p>\n"},"content.vb":"Function IsCommandRegistered(commandName As String) As Boolean"},"File":"api/GameFramework.ConsoleTool.IConsoleContext.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.ConsoleTool.IConsoleContext.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"4\">Checks if a command with the specified name is currently registered in the system\nUseful for conditional command execution and validation in complex command scripts\nCommand names are case-insensitive</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Data.LoadingConfiguration","Summary":"<p sourcefile=\"api/GameFramework.StateMachine.Data.LoadingConfiguration.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Configuration data for different loading scenarios</p>\n","Type":"class","Syntax":{"content":"public class LoadingConfiguration","content.vb":"Public Class LoadingConfiguration"},"File":"api/GameFramework.StateMachine.Data.LoadingConfiguration.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Data.LoadingConfiguration.Type","Type":"property","Syntax":{"content":"public LoadingType Type { get; set; }","parameters":[],"return":{"type":"LoadingType"},"content.vb":"Public Property Type As LoadingType"},"File":"api/GameFramework.StateMachine.Data.LoadingConfiguration.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Data.LoadingConfiguration.SceneName","Type":"property","Syntax":{"content":"public string SceneName { get; set; }","parameters":[],"return":{"type":"System.String"},"content.vb":"Public Property SceneName As String"},"File":"api/GameFramework.StateMachine.Data.LoadingConfiguration.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfa