eType"}},"File":"api/GameFramework.StateMachine.Enum.GameStateType.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Enum.GameStateType.MainMenu","Type":"field","Syntax":{"content":"MainMenu = 2","return":{"type":"GameFramework.StateMachine.Enum.GameStateType"}},"File":"api/GameFramework.StateMachine.Enum.GameStateType.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Enum.GameStateType.Loading","Type":"field","Syntax":{"content":"Loading = 3","return":{"type":"GameFramework.StateMachine.Enum.GameStateType"}},"File":"api/GameFramework.StateMachine.Enum.GameStateType.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Enum.GameStateType.NewGame","Type":"field","Syntax":{"content":"NewGame = 4","return":{"type":"GameFramework.StateMachine.Enum.GameStateType"}},"File":"api/GameFramework.StateMachine.Enum.GameStateType.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Enum.GameStateType.Playing","Type":"field","Syntax":{"content":"Playing = 5","return":{"type":"GameFramework.StateMachine.Enum.GameStateType"}},"File":"api/GameFramework.StateMachine.Enum.GameStateType.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Enum.GameStateType.Credits","Type":"field","Syntax":{"content":"Credits = 6","return":{"type":"GameFramework.StateMachine.Enum.GameStateType"}},"File":"api/GameFramework.StateMachine.Enum.GameStateType.yml","Metadata":{"type":"field","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.Enum.GameStateType.GameOver","Type":"field","Syntax":{"content":"Game