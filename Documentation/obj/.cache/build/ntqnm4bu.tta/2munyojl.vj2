work.Services.ConfigService.LoadConfigAsync","Type":"method","Syntax":{"content":"public async Task LoadConfigAsync()","return":{"type":"Task"},"content.vb":"Public Function LoadConfigAsync As Task"},"File":"api/GameFramework.Services.ConfigService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.ConfigService.SaveConfigAsync","Type":"method","Syntax":{"content":"public async Task SaveConfigAsync()","return":{"type":"Task"},"content.vb":"Public Function SaveConfigAsync As Task"},"File":"api/GameFramework.Services.ConfigService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.ConfigService.GetConfigValue``1(System.String)","Type":"method","Syntax":{"content":"public T GetConfigValue<T>(string configName)","parameters":[{"id":"configName","type":"System.String"}],"typeParameters":[{"id":"T"}],"return":{"type":"{T}"},"content.vb":"Public Function GetConfigValue(Of T)(configName As String) As T"},"File":"api/GameFramework.Services.ConfigService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.ConfigService.SetConfigValue``1(System.String,``0)","Type":"method","Syntax":{"content":"public void SetConfigValue<T>(string configName, T value)","parameters":[{"id":"configName","type":"System.String"},{"id":"value","type":"{T}"}],"typeParameters":[{"id":"T"}],"content.vb":"Public Sub SetConfigValue(Of T)(configName As String, value As T)"},"File":"api/GameFramework.Services.ConfigService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.ConfigService.ResetToDefaults","Type":"method","Syntax":{"content":"public void ResetToDefaults()","content.vb":"Public Sub ResetToDefaults"},"File":"api/GameFramework.Services.ConfigService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.ConfigService.GetDebugInfo","Summary":"<p sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Get debug information about registered categories and variables</p>\n","Type":"method","Syntax":{"content":"public string GetDebugInfo()","return":{"type":"System.String"},"content.vb":"Public Function GetDebugInfo As String"},"File":"api/GameFramework.Services.ConfigService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.ConfigService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Get debug information about registered categories and variables</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.UIRightClickInputEvent","Type":"class","Syntax":{"content":"public class UIRightClickInputEvent","content.vb":"Public Class UIRightClickInputEvent"},"File":"api/GameFramework.EventSystem.Events.UIRightClickInputEvent.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.EventSystem.Events.UIRightClickInputEvent.#ctor","Type":"constructor","Syntax":{"content":"public UIRightClickInputEvent()","content.vb":"Public Sub New"},"File":"api/GameFramework.EventSystem.Events.UIRightClickInputEvent.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Utilities","Type":"namespace","File":"api/GameFramework.UI.Utilities.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup","Summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Enhanced debug popup with real-time performance graphs\nDisplays FPS, memory consumption, and historical graphs of both metrics</p>\n<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"5\" sourceendlinenumber=\"5\">Design:</p>\n<ul sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"9\">\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"6\" sourceendlinenumber=\"6\">Integrates custom GraphElement controls for visual data representation</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"7\" sourceendlinenumber=\"7\">Maintains separate data collection intervals for metrics vs graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"8\" sourceendlinenumber=\"8\">Uses color-coded indicators for quick performance assessment</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"9\" sourceendlinenumber=\"9\">Efficient data sampling to prevent performance impact</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"11\" sourceendlinenumber=\"11\">Pros:</p>\n<ul sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"17\">\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"12\" sourceendlinenumber=\"12\">Visual trend analysis with historical graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"13\" sourceendlinenumber=\"13\">Real-time performance monitoring with color coding</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"14\" sourceendlinenumber=\"14\">Memory efficient circular buffers for data storage</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"15\" sourceendlinenumber=\"15\">Configurable graph appearance and scaling</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"16\" sourceendlinenumber=\"16\">Clean separation between text metrics and visual graphs</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"17\" sourceendlinenumber=\"17\">Can be toggled on/off as overlay popup</li>\n</ul>\n<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"19\" sourceendlinenumber=\"19\">Cons:</p>\n<ul sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"20\" sourceendlinenumber=\"22\">\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"20\" sourceendlinenumber=\"20\">Increased memory usage for graph data storage</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"21\" sourceendlinenumber=\"21\">Additional rendering overhead for custom graph elements</li>\n<li sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"22\" sourceendlinenumber=\"22\">More complex initialization and cleanup</li>\n</ul>\n","Type":"class","Syntax":{"content":"public class DebugPopup : UIPopup","content.vb":"Public Class DebugPopup\n    Inherits UIPopup"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.#ctor(VisualElement)","Type":"constructor","Syntax":{"content":"public DebugPopup(VisualElement rootElement)","parameters":[{"id":"rootElement","type":"VisualElement"}],"content.vb":"Public Sub New(rootElement As VisualElement)"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.OnShow","Type":"method","Syntax":{"content":"protected override void OnShow()","content.vb":"Protected Overrides Sub OnShow"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.OnHide","Type":"method","Syntax":{"content":"protected override void OnHide()","content.vb":"Protected Overrides Sub OnHide"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.OnUpdate(System.Single)","Type":"method","Syntax":{"content":"protected override void OnUpdate(float deltaTime)","parameters":[{"id":"deltaTime","type":"System.Single"}],"content.vb":"Protected Overrides Sub OnUpdate(deltaTime As Single)"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.ClearGraphs","Summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Clear all graph data (useful for testing or resetting)</p>\n","Type":"method","Syntax":{"content":"public void ClearGraphs()","content.vb":"Public Sub ClearGraphs"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Clear all graph data (useful for testing or resetting)</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.SetGraphUpdateInterval(System.Single)","Summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Configure graph update intervals</p>\n","Type":"method","Syntax":{"content":"public void SetGraphUpdateInterval(float intervalSeconds)","parameters":[{"id":"intervalSeconds","type":"System.Single"}],"content.vb":"Public Sub SetGraphUpdateInterval(intervalSeconds As Single)"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Configure graph update intervals</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.SetText(System.String)","Type":"method","Syntax":{"content":"public void SetText(string text)","parameters":[{"id":"text","type":"System.String"}],"content.vb":"Public Sub SetText(text As String)"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.SetRichText(System.String)","Type":"method","Syntax":{"content":"public void SetRichText(string richText)","parameters":[{"id":"richText","type":"System.String"}],"content.vb":"Public Sub SetRichText(richText As String)"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.GetCurrentFPS","Type":"method","Syntax":{"content":"public float GetCurrentFPS()","return":{"type":"System.Single"},"content.vb":"Public Function GetCurrentFPS As Single"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.GetCurrentMemoryUsage","Type":"method","Syntax":{"content":"public long GetCurrentMemoryUsage()","return":{"type":"System.Int64"},"content.vb":"Public Function GetCurrentMemoryUsage As Long"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.Cleanup","Type":"method","Syntax":{"content":"public override void Cleanup()","content.vb":"Public Overrides Sub Cleanup"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.UI.Popups.DebugPopup.CountsAsGameBlockingPopup","Summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Debug popup doesn&apos;t block game operations</p>\n","Type":"property","Syntax":{"content":"public override bool CountsAsGameBlockingPopup { get; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public Overrides ReadOnly Property CountsAsGameBlockingPopup As Boolean"},"File":"api/GameFramework.UI.Popups.DebugPopup.yml","Metadata":{"type":"property","summary":"<p sourcefile=\"api/GameFramework.UI.Popups.DebugPopup.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Debug popup doesn&apos;t block game operations</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.EventRegistry","Type":"class","Syntax":{"content":"public class EventRegistry : IDisposable","content.vb":"Public Class EventRegistry\n    Inherits IDisposable"},"File":"api/UCTools_Utilities.EventRegistry.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.EventRegistry.RegisterCallback``1(VisualElement,Action{``0})","Type":"method","Syntax":{"content":"public void RegisterCallback<TEvent>(VisualElement visualElement, Action<TEvent> callback)\n    where TEvent : EventBase<TEvent>, new()","parameters":[{"id":"visualElement","type":"VisualElement"},{"id":"callback","type":"Action{{TEvent}}"}],"typeParameters":[{"id":"TEvent"}],"content.vb":"Public Sub RegisterCallback(Of TEvent As {EventBase(Of TEvent), New})(visualElement As VisualElement, callback As Action(Of TEvent))"},"File":"api/UCTools_Utilities.EventRegistry.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.