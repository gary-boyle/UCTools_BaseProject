f truth for all game state information\nDelegates all save/load operations to SaveService\nUses TimeService for all playtime tracking - no manual time management</p>\n","Type":"class","Syntax":{"content":"public class GameDataService : IGameDataService","content.vb":"Public Class GameDataService\n    Inherits IGameDataService"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.IsInitialized","Type":"property","Syntax":{"content":"public bool IsInitialized { get; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public ReadOnly Property IsInitialized As Boolean"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.CurrentSession","Type":"property","Syntax":{"content":"public GameSession CurrentSession { get; }","parameters":[],"return":{"type":"GameSession"},"content.vb":"Public ReadOnly Property CurrentSession As GameSession"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.CurrentLoadingConfig","Type":"property","Syntax":{"content":"public LoadingConfiguration CurrentLoadingConfig { get; set; }","parameters":[],"return":{"type":"LoadingConfiguration"},"content.vb":"Public Property CurrentLoadingConfig As LoadingConfiguration"},"File":"api/GameFramework.Services.GameDataService.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.GameDataService.OnSessionCreated","Type":"event","Syntax":{"content":"public event Action<GameSession> OnSessionCreated","return":{"type":"Action{GameSession}"},"content.vb":"Public Event OnSessionCreated As Action(Of 