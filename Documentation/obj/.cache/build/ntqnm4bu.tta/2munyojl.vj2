dationMode.LogWarnings, params VisualElement[] elements)","parameters":[{"id":"contextName","type":"System.String","description":"<p sourcefile=\"api/UCTools_Utilities.UI.UIElementValidator.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">Name of the UI class for error messages</p>\n"},{"id":"mode","type":"UCTools_Utilities.UI.UIElementValidator.ValidationMode","description":"<p sourcefile=\"api/UCTools_Utilities.UI.UIElementValidator.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">How to handle validation failures</p>\n"},{"id":"elements","type":"VisualElement[]","description":"<p sourcefile=\"api/UCTools_Utilities.UI.UIElementValidator.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">The UI elements to validate</p>\n"}],"return":{"type":"System.Boolean","description":"<p sourcefile=\"api/UCTools_Utilities.UI.UIElementValidator.yml\" sourcestartlinenumber=\"1\" sourceendlinenumber=\"1\">True if all elements are valid</p>\n"},"content.vb":"Public Shared Function ValidateElements(contextName As String, mode As UIElementValidator.ValidationMode = UIElementValidator.ValidationMode.LogWarnings, ParamArray elements As VisualElement()) As Boolean"},"File":"api/UCTools_Utilities.UI.UIElementValidator.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/UCTools_Utilities.UI.UIElementValidator.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Validates a collection of UI elements - just pass the elements directly\nNote: For detailed error reporting with field names, use ValidateElementsWithNames instead</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"UCTools_Utilities.UI.UIElementValidator.ValidateElementsWithNames``1(``0,UCTools_Utilities.UI.UIElementValidator.ValidationMode)","Summary":"<p sourcefile=\"api/UCTools_Utilities.UI.UIElementValidator.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"3\">Validates elements and gets field names via reflection for detailed error reporting\nThis