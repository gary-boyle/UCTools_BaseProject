ecial autosave handling\nAutosaves always overwrite existing autosave files to prevent save directory bloat\nWorks with GameDataService as the single source of session data\nIntegrates with TimeService for accurate playtime tracking</p>\n","Type":"class","Syntax":{"content":"public class SaveService : ISaveService","content.vb":"Public Class SaveService\n    Inherits ISaveService"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.IsInitialized","Type":"property","Syntax":{"content":"public bool IsInitialized { get; }","parameters":[],"return":{"type":"System.Boolean"},"content.vb":"Public ReadOnly Property IsInitialized As Boolean"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.#ctor(IEventSystem)","Type":"constructor","Syntax":{"content":"public SaveService(IEventSystem eventSystem)","parameters":[{"id":"eventSystem","type":"IEventSystem"}],"content.vb":"Public Sub New(eventSystem As IEventSystem)"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{"type":"constructor","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.InitializeAsync","Type":"method","Syntax":{"content":"public async Task InitializeAsync()","return":{"type":"Task"},"content.vb":"Public Function InitializeAsync As Task"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.Shutdown","Type":"method","Syntax":{"content":"public void Shutdown()","content.vb":"Public Sub Shutdown"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.CanSaveGame","Summary":"<p sourcefile=\"api/GameFramework.Services.SaveService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if the game can currently be saved based on session state</p>\n","Type":"method","Syntax":{"content":"public bool CanSaveGame()","return":{"type":"System.Boolean"},"content.vb":"Public Function CanSaveGame As Boolean"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.SaveService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Checks if the game can currently be saved based on session state</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.PerformRegularSaveAsync","Summary":"<p sourcefile=\"api/GameFramework.Services.SaveService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Performs a regular save with automatic timestamp-based naming</p>\n","Type":"method","Syntax":{"content":"public async Task<(bool success, string saveName)> PerformRegularSaveAsync()","return":{"type":"Task{System.ValueTuple{System.Boolean,System.String}}"},"content.vb":"Public Function PerformRegularSaveAsync As Task(Of(success As Boolean, saveName As String)(Of Boolean , String))"},"File":"api/GameFramework.Services.SaveService.yml","Metadata":{"type":"method","summary":"<p sourcefile=\"api/GameFramework.Services.SaveService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Performs a regular save with automatic timestamp-based naming</p>\n","platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.Services.SaveService.PerformAutoSaveAsync","Summary":"<p sourcefile=\"api/GameFramework.Services.SaveService.yml\" sourcestartlinenumber=\"2\" sourceendlinenumber=\"2\">Performs an autosave, always overwriting the existing autosave file</p>\n","Type":"method","Syntax":{"content":"public async Task<(bool succe