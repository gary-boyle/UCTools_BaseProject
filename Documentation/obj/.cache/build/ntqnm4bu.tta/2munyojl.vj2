 and transition validation\nPros: Robust state management, prevents invalid transitions, supports complex state logic, Unity compatible\nCons: More complex than simple state switching, requires careful transition planning, explicit state definitions</p>\n","Type":"interface","Syntax":{"content":"public interface IGameStateMachine","content.vb":"Public Interface IGameStateMachine\n    Inherits IGameService"},"File":"api/GameFramework.StateMachine.IGameStateMachine.yml","Metadata":{},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.IGameStateMachine.CurrentStateType","Type":"property","Syntax":{"content":"GameStateType CurrentStateType { get; }","parameters":[],"return":{"type":"GameStateType"},"content.vb":"ReadOnly Property CurrentStateType As GameStateType"},"File":"api/GameFramework.StateMachine.IGameStateMachine.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.IGameStateMachine.CurrentState","Type":"property","Syntax":{"content":"BaseGameState CurrentState { get; }","parameters":[],"return":{"type":"BaseGameState"},"content.vb":"ReadOnly Property CurrentState As BaseGameState"},"File":"api/GameFramework.StateMachine.IGameStateMachine.yml","Metadata":{"type":"property","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.IGameStateMachine.ChangeStateAsync(GameStateType)","Type":"method","Syntax":{"content":"Task ChangeStateAsync(GameStateType newStateType)","parameters":[{"id":"newStateType","type":"GameStateType"}],"return":{"type":"Task"},"content.vb":"Function ChangeStateAsync(newStateType As GameStateType) As Task"},"File":"api/GameFramework.StateMachine.IGameStateMachine.yml","Metadata":{"type":"method","summary":null,"platform":null},"IsExplicitInterfaceImplementation":false},{"Uid":"GameFramework.StateMachine.IGameStateMachine.ChangeStateAsync``1","Type":"method","Syntax":{"cont