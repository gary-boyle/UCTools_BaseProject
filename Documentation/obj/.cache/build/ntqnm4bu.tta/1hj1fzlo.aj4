      <tr>
        <td><span class="xref">System.Int32</span></td>
        <td><span class="parametername">frames</span></td>
        <td><p sourcefile="api/GameFramework.ConsoleTool.IConsoleContext.yml" sourcestartlinenumber="1" sourceendlinenumber="1">Number of frames to wait (must be &gt;= 0)</p>
</td>
      </tr>
    </tbody>
  </table>
  
  
