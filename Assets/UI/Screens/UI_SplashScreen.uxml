<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Splash Screen Stylesheets -->
    <Style src="project://database/Assets/UI/USS/core.uss" />
    <Style src="project://database/Assets/UI/USS/typography.uss" />
    <Style src="project://database/Assets/UI/USS/layout.uss" />
    <Style src="project://database/Assets/UI/USS/utilities.uss" />
    <engine:VisualElement name="UI_SplashWindow" class="ui-screen layout-center" style="display: flex;">
        <engine:VisualElement class="layout-column layout-center fade-in">
            <engine:Label text="Utter Chaos Games" class="text--hero text--center" />
            <engine:Label text="Presents" class="text--xl text--secondary text--center mt-lg" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
