<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Widget_CloseButton" src="project://database/Assets/UI/Widgets/Widget_CloseButton.uxml?fileID=9197481963319205126&amp;guid=0ae08ca0a349c17499c551fac1d2415c&amp;type=3#Widget_CloseButton" />
    <Style src="project://database/Assets/UI/USS/default.uss?fileID=7433441132597879392&amp;guid=2a57d33c3711ed14f864a6368b02fede&amp;type=3#default" />
    <engine:VisualElement name="VisualElement" class="screenBackground">
        <engine:Label text="New Game" name="lbl_Options" class="defaultText" style="font-size: 103px;" />
        <engine:VisualElement class="defaultText" style="justify-content: center;">
            <engine:VisualElement style="flex-direction: row; align-items: center;">
                <engine:Label text="Name" name="lbl_Name" />
                <engine:TextField placeholder-text="Player Name" name="txt_PlayerName">
                    <Bindings>
                        <engine:DataBinding property="value" data-source-path="_playerName" binding-mode="TwoWay" />
                    </Bindings>
                </engine:TextField>
            </engine:VisualElement>
            <engine:DropdownField label="Difficulty" name="dd_Difficulty" />
            <engine:Button text="Confirm" name="btn_Confirm" class="defaultButton" style="margin-top: 10px;" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:Instance template="Widget_CloseButton" name="CloseContainer" class="closeButtonPosition" />
</engine:UXML>
