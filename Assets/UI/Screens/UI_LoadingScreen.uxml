<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Loading Screen Stylesheets -->
    <Style src="project://database/Assets/UI/USS/core.uss" />
    <Style src="project://database/Assets/UI/USS/typography.uss" />
    <Style src="project://database/Assets/UI/USS/layout.uss" />
    <Style src="project://database/Assets/UI/USS/components.uss" />
    <Style src="project://database/Assets/UI/USS/utilities.uss" />
    <engine:VisualElement name="UI_SplashWindow" class="ui-screen layout-center" style="display: flex;">
        <engine:VisualElement class="layout-column layout-center">
            <engine:Label text="Loading..." name="lbl_LoadingText" class="text--hero mb-xl" />
            <engine:VisualElement class="ui-container layout-center p-xl">
                <engine:VisualElement name="progress-container" class="progress-container mb-lg" style="width: 300px; height: 20px;">
                    <engine:ProgressBar name="loading-progress" low-value="0" high-value="1" value="0" class="loading-progress" style="width: 100%; height: 100%;" />
                </engine:VisualElement>
                <engine:Label text="Please wait while the game loads..." name="lbl_LoadingMessage" class="text--secondary text--center" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
