<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Credits Screen Stylesheets -->
    <Style src="project://database/Assets/UI/USS/core.uss" />
    <Style src="project://database/Assets/UI/USS/typography.uss" />
    <Style src="project://database/Assets/UI/USS/buttons.uss" />
    <Style src="project://database/Assets/UI/USS/layout.uss" />
    <Style src="project://database/Assets/UI/USS/utilities.uss" />
    <engine:VisualElement name="UI_SplashWindow" class="ui-screen layout-center" style="display: flex;">
        <engine:VisualElement class="layout-column layout-center">
            <engine:Label text="Credits" class="text--hero mb-xl" />
            <engine:VisualElement class="ui-container layout-column layout-center p-xl">
                <engine:Label text="Game Development" class="text--display mb-lg" />
                <engine:Label text="Made by Gary" class="text--xl text--center mb-xl" />
                <engine:Label text="Special Thanks" class="text--lg text--secondary mb-md" />
                <engine:Label text="Unity Technologies" class="text text--center mb-sm" />
                <engine:Label text="The Gaming Community" class="text text--center mb-xl" />
                <engine:Button text="Back to Main Menu" name="btn_BackToMenu" class="btn btn--primary btn--large mt-xl" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
