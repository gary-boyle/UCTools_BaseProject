<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Widget_CloseButton" src="project://database/Assets/UI/Widgets/Widget_CloseButton.uxml?fileID=9197481963319205126&amp;guid=0ae08ca0a349c17499c551fac1d2415c&amp;type=3#Widget_CloseButton" />
    <Style src="project://database/Assets/UI/USS/default.uss?fileID=7433441132597879392&amp;guid=2a57d33c3711ed14f864a6368b02fede&amp;type=3#default" />
    <engine:VisualElement name="VisualElement">
        <engine:VisualElement name="content_Main">
            <engine:Label text="Save Game" name="lbl_Title" class="text--hero mb-xl" />
            <engine:VisualElement class="ui-container layout-column layout-grow">
                <engine:VisualElement class="mb-lg">
                    <engine:Label text="Save files are automatically named with timestamps" class="text--tertiary text--sm" />
                    <engine:Label text="Double-click an existing save to overwrite it" class="text--tertiary text--sm" />
                </engine:VisualElement>
                <engine:VisualElement class="layout-grow">
                    <engine:Label text="Existing Saves:" class="text--secondary mb-md" />
                    <engine:ListView name="list_SaveFiles" item-template="project://database/Assets/UI/Widgets/Widget_SaveFileInfo.uxml?fileID=9197481963319205126&amp;guid=e2383e1d2eca413d8739f479bd18f7ac&amp;type=3#Widget_SaveFileInfo" virtualization-method="DynamicHeight" show-add-remove-footer="false" show-border="true" class="list layout-grow" />
                </engine:VisualElement>
                <engine:VisualElement class="mt-lg">
                    <engine:Label name="lbl_Status" class="text--secondary mb-md save-status-label" />
                    <engine:VisualElement class="layout-row layout-space-between">
                        <engine:Button text="Delete Selected" name="btn_DeleteSelected" class="btn btn--danger" />
                        <engine:VisualElement class="layout-row">
                            <engine:Button text="Auto Save" name="btn_AutoSave" class="btn btn--secondary mr-md" />
                            <engine:Button text="Save Game" name="btn_Save" class="btn btn--primary btn--large" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Instance template="Widget_CloseButton" name="CloseContainer" class="btn--close" />
        </engine:VisualElement>
        <engine:VisualElement name="overlay_SavingProgress" class="ui-modal-overlay hidden">
            <engine:VisualElement class="ui-modal-panel layout-center layout-column">
                <engine:Label name="lbl_SavingTitle" text="Saving Game..." class="text--hero text--center mb-lg" />
                <engine:ProgressBar name="progress_Bar" value="0" class="saving-progress mb-lg" />
                <engine:Label name="lbl_SavingStatus" text="Please wait..." class="text--secondary text--sm text--center" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
