<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/default.uss?fileID=7433441132597879392&amp;guid=2a57d33c3711ed14f864a6368b02fede&amp;type=3#default" />
    <ui:VisualElement name="UI_DebugPopup" picking-mode="Ignore" class="debug-overlay" style="padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px;">
        <ui:VisualElement picking-mode="Ignore" class="layout-column layout-space-between layout-grow">
            <ui:VisualElement picking-mode="Ignore" class="layout-column">
                <ui:VisualElement picking-mode="Ignore" class="layout-row layout-space-between" style="margin-bottom: 10px; flex-direction: column; align-items: flex-start;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:Label name="lbl_Debug" enable-rich-text="true" text="Debug Information" picking-mode="Ignore" class="debug-text text--xl" />
                        <ui:VisualElement picking-mode="Ignore" class="layout-row">
                            <ui:Label text="Status:" picking-mode="Ignore" class="debug-text text--sm metric-label" />
                            <ui:Label name="lbl_Session_Status" text="Initializing..." picking-mode="Ignore" class="debug-text text--sm metric-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="layout-row" style="flex-wrap: wrap;">
                        <ui:Label text="FPS:" picking-mode="Ignore" class="debug-text metric-label" />
                        <ui:Label name="lbl_FPS_Current" text="60.0" picking-mode="Ignore" class="debug-text metric-value" />
                        <ui:Label text="|" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 8px; margin-right: 8px;" />
                        <ui:Label text="Avg:" picking-mode="Ignore" class="debug-text metric-label" />
                        <ui:Label name="lbl_FPS_Avg" text="60.0" picking-mode="Ignore" class="debug-text metric-value" />
                        <ui:Label text="|" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 8px; margin-right: 8px;" />
                        <ui:Label text="Min:" picking-mode="Ignore" class="debug-text metric-label" />
                        <ui:Label name="lbl_FPS_Min" text="60.0" picking-mode="Ignore" class="debug-text metric-value" />
                        <ui:Label text="|" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 8px; margin-right: 8px;" />
                        <ui:Label text="Max:" picking-mode="Ignore" class="debug-text metric-label" />
                        <ui:Label name="lbl_FPS_Max" text="60.0" picking-mode="Ignore" class="debug-text metric-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="container_FPSGraph" picking-mode="Ignore" style="flex-direction: column; align-items: center;">
                        <ui:VisualElement name="graph_FPS" picking-mode="Ignore" style="width: 180px; height: 50px;" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="layout-row" style="align-items: flex-end;">
                        <ui:Label text="Memory:" picking-mode="Ignore" class="debug-text metric-label" />
                        <ui:Label name="lbl_Memory_Value" text="256.0" picking-mode="Ignore" class="debug-text" style="margin-right: 0;" />
                        <ui:Label text="MB" picking-mode="Ignore" class="debug-text metric-label" style="font-size: 15px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="container_MemoryGraph" picking-mode="Ignore" style="flex-direction: column; align-items: center;">
                        <ui:VisualElement name="graph_Memory" picking-mode="Ignore" style="width: 180px; height: 50px;" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="layout-row">
                        <ui:Label text="Draw Calls:" picking-mode="Ignore" class="debug-text metric-label" />
                        <ui:Label name="lbl_DrawCalls_Value" text="0" picking-mode="Ignore" class="debug-text metric-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="container_DrawCallsGraph" picking-mode="Ignore" style="flex-direction: column; align-items: center;">
                        <ui:VisualElement name="graph_DrawCalls" picking-mode="Ignore" style="width: 180px; height: 50px;" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="layout-row" style="flex-wrap: wrap; align-items: flex-end;">
                        <ui:Label text="Batches:" picking-mode="Ignore" class="debug-text text--sm metric-label" />
                        <ui:Label name="lbl_Batches_Value" text="0" picking-mode="Ignore" class="debug-text text--sm metric-value" />
                        <ui:Label text="|" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 8px; margin-right: 8px;" />
                        <ui:Label text="Tris:" picking-mode="Ignore" class="debug-text text--sm metric-label" />
                        <ui:Label name="lbl_Triangles_Value" text="0" picking-mode="Ignore" class="debug-text" style="margin-right: 0;" />
                        <ui:Label name="lbl_Triangles_Unit" text="K" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 0; font-size: 15px;" />
                        <ui:Label text="|" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 8px; margin-right: 8px;" />
                        <ui:Label text="Verts:" picking-mode="Ignore" class="debug-text text--sm metric-label" />
                        <ui:Label name="lbl_Vertices_Value" text="0" picking-mode="Ignore" class="debug-text" style="margin-right: 0;" />
                        <ui:Label name="lbl_Vertices_Unit" text="K" picking-mode="Ignore" class="debug-text text--sm metric-label" style="margin-left: 0; font-size: 15px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="layout-row layout-space-between" style="margin-bottom: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="layout-center" />
            <ui:VisualElement picking-mode="Ignore" class="layout-row layout-space-between">
                <ui:VisualElement picking-mode="Ignore" class="layout-row">
                    <ui:Label text="Version:" picking-mode="Ignore" class="debug-text text--sm metric-label" />
                    <ui:Label name="lbl_Version_Value" text="1.0.0" picking-mode="Ignore" class="debug-text text--sm metric-value" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="layout-row">
                    <ui:Label text="Build:" picking-mode="Ignore" class="debug-text text--sm metric-label" />
                    <ui:Label name="lbl_Build_Value" text="Debug" picking-mode="Ignore" class="debug-text text--sm metric-value" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
