<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Widget_CloseButton" src="project://database/Assets/UI/Widgets/Widget_CloseButton.uxml?fileID=9197481963319205126&amp;guid=0ae08ca0a349c17499c551fac1d2415c&amp;type=3#Widget_CloseButton" />
    <!-- Load Game Popup Stylesheets -->
    <Style src="project://database/Assets/UI/USS/core.uss" />
    <Style src="project://database/Assets/UI/USS/typography.uss" />
    <Style src="project://database/Assets/UI/USS/buttons.uss" />
    <Style src="project://database/Assets/UI/USS/layout.uss" />
    <Style src="project://database/Assets/UI/USS/components.uss" />
    <Style src="project://database/Assets/UI/USS/utilities.uss" />
    <engine:VisualElement name="VisualElement">
        <engine:Label text="Load Game" name="lbl_Title" class="text--hero mb-xl" />
        <engine:VisualElement class="ui-container layout-column layout-grow">
            <engine:VisualElement class="mb-lg">
                <engine:Label text="Select a save file to load (double-click to load):" class="text--secondary mb-md" />
            </engine:VisualElement>
            <engine:VisualElement class="layout-grow">
                <engine:ListView name="list_SaveFiles" item-template="project://database/Assets/UI/Widgets/Widget_SaveFileInfo.uxml?fileID=9197481963319205126&amp;guid=e2383e1d2eca413d8739f479bd18f7ac&amp;type=3#Widget_SaveFileInfo" virtualization-method="DynamicHeight" show-add-remove-footer="false" show-border="true" class="list layout-grow" />
            </engine:VisualElement>
            <engine:VisualElement class="mt-lg">
                <engine:Label name="lbl_Status" class="text--secondary mb-md" />
                <engine:VisualElement class="layout-row layout-space-between">
                    <engine:Button text="Delete Selected" name="btn_DeleteSelected" class="btn btn--danger" />
                    <engine:Button text="Load Game" name="btn_Load" class="btn btn--primary btn--large" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Instance template="Widget_CloseButton" name="CloseContainer" class="btn--close" style="display: flex;" />
    </engine:VisualElement>
</engine:UXML>
