<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Widget_CloseButton" src="project://database/Assets/UI/Widgets/Widget_CloseButton.uxml?fileID=9197481963319205126&amp;guid=0ae08ca0a349c17499c551fac1d2415c&amp;type=3#Widget_CloseButton" />
    <Style src="project://database/Assets/UI/USS/default.uss?fileID=7433441132597879392&amp;guid=2a57d33c3711ed14f864a6368b02fede&amp;type=3#default" />
    <engine:VisualElement name="VisualElement">
        <engine:VisualElement class="layout-column layout-grow p-lg">
            <engine:Label text="Options" name="lbl_Options" class="text--hero mb-xl" />
            <engine:TabView name="OptionsTabView" class="tab-view layout-grow">
                <engine:Tab label="Audio" name="AudioTab" class="tab-header">
                    <engine:VisualElement name="AudioOptions" class="tab-content">
                        <engine:Toggle label="Audio Enabled" name="tgl_EnableAudio" class="toggle mb-md" />
                        <engine:SliderInt label="Master Volume" value="100" high-value="100" name="slider_MasterVolume" fill="true" class="slider mb-md" />
                        <engine:SliderInt label="Music Volume" value="80" high-value="100" fill="true" name="slider_MusicVolume" class="slider mb-md" />
                        <engine:SliderInt label="SFX Volume" value="90" high-value="100" name="slider_SFXVolume" fill="true" class="slider mb-md" />
                        <engine:SliderInt label="UI Volume" value="90" high-value="100" name="slider_UIVolume" fill="true" class="slider mb-md" />
                    </engine:VisualElement>
                </engine:Tab>
                <engine:Tab label="Graphics" name="GraphicsTab" class="tab-header">
                    <engine:VisualElement name="GraphicsOptions" class="tab-content">
                        <engine:Toggle label="Fullscreen" name="tgl_FullScreen" class="toggle mb-md" />
                        <engine:Toggle label="VSync" name="tgl_Vsync" class="toggle mb-md" />
                        <engine:DropdownField label="Quality" name="dd_Quality" choices="test" index="0" class="dropdown mb-md" />
                        <engine:DropdownField label="Resolution" name="dd_Resolution" class="dropdown mb-md" />
                    </engine:VisualElement>
                </engine:Tab>
                <engine:Tab label="Gameplay" name="GameplayTab" class="tab-header">
                    <engine:VisualElement name="GameplayOptions" class="tab-content">
                        <engine:DropdownField label="Difficulty" name="dd_Difficulty" class="dropdown mb-md" />
                        <engine:Toggle label="Auto Save" name="tgl_AutoSave" class="toggle mb-md" />
                        <engine:SliderInt label="Auto Save Interval (seconds)" value="300" low-value="30" high-value="3600" name="slider_AutoSaveInterval" fill="true" class="slider mb-md" />
                    </engine:VisualElement>
                </engine:Tab>
                <engine:Tab label="Input" name="InputTab" class="tab-header">
                    <engine:VisualElement name="InputOptions" class="tab-content">
                        <engine:Slider label="Mouse Sensitivity" value="1.0" low-value="0.1" high-value="10.0" name="slider_MouseSensitivity" fill="true" class="slider mb-md" />
                        <engine:Toggle label="Invert Y Axis" name="tgl_InvertYAxis" class="toggle mb-md" />
                    </engine:VisualElement>
                </engine:Tab>
                <engine:Tab label="Debug" name="DebugTab" class="tab-header">
                    <engine:VisualElement name="DebugOptions" class="tab-content">
                        <engine:Toggle label="Show Debug Info" name="tgl_ShowDebugInfo" value="true" class="toggle mb-md" />
                        <engine:Toggle label="Verbose Logging" name="tgl_VerboseLogging" class="toggle mb-md" />
                        <engine:Toggle label="Console Enabled" name="tgl_ConsoleEnabled" class="toggle mb-md" />
                    </engine:VisualElement>
                </engine:Tab>
            </engine:TabView>
            <engine:VisualElement class="layout-row layout-center mt-lg">
                <engine:Button text="Reset to Defaults" name="btn_Reset" class="btn btn--secondary mr-md" />
                <engine:Button text="Apply Settings" name="btn_Apply" class="btn btn--primary" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Instance template="Widget_CloseButton" name="CloseContainer" class="btn--close" />
    </engine:VisualElement>
</engine:UXML>
