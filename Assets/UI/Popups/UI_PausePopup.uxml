<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Widget_CloseButton" src="project://database/Assets/UI/Widgets/Widget_CloseButton.uxml?fileID=9197481963319205126&amp;guid=0ae08ca0a349c17499c551fac1d2415c&amp;type=3#Widget_CloseButton" />
    <Style src="project://database/Assets/UI/USS/default.uss?fileID=7433441132597879392&amp;guid=2a57d33c3711ed14f864a6368b02fede&amp;type=3#default" />
    <engine:VisualElement>
        <engine:VisualElement class="layout-column layout-center p-xl">
            <engine:Label text="Game Paused" class="text--hero mb-xl" />
            <engine:VisualElement class="layout-column layout-center">
                <engine:Button text="Options" name="btn_Options" class="btn btn--secondary btn--large mb-md" />
                <engine:Button text="Save Game" name="btn_Save" class="btn btn--secondary btn--large mb-md" />
                <engine:Button text="Load Game" name="btn_Load" class="btn btn--secondary btn--large mb-md" />
                <engine:Button text="Main Menu" name="btn_MainMenu" class="btn btn--secondary btn--large mb-md" />
                <engine:Button text="Quit Game" name="btn_Quit" class="btn btn--danger btn--large" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Instance template="Widget_CloseButton" class="btn--close" />
    </engine:VisualElement>
</engine:UXML>
