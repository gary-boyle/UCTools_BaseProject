.layout-row {
    flex-direction: row;
    align-items: center;
}

.layout-column {
    flex-direction: column;
}

.layout-center {
    align-items: center;
    justify-content: center;
}

.layout-space-between {
    justify-content: space-between;
}

.layout-grow {
    flex-grow: 1;
}

.m-sm {
    margin: 8px;
}

.m-md {
    margin: 16px;
}

.m-lg {
    margin: 24px;
}

.m-xl {
    margin: 32px;
}

.mt-sm {
    margin-top: 8px;
}

.mt-md {
    margin-top: 16px;
}

.mt-lg {
    margin-top: 24px;
}

.mt-xl {
    margin-top: 15px;
}

.mb-sm {
    margin-bottom: 8px;
}

.mb-md {
    margin-bottom: 16px;
}

.mb-lg {
    margin-bottom: 24px;
}

.mb-xl {
    margin-bottom: 32px;
}

.mb-xxl {
}

.mr-md {
    margin-right: 16px;
}

.p-md {
    padding: 16px;
}

.p-lg {
    padding: 24px;
}

.p-xl {
    padding: 32px;
    padding-top: 63px;
    padding-right: 63px;
    padding-bottom: 63px;
    padding-left: 63px;
}
