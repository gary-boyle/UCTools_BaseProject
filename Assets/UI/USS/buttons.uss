.btn {
    height: 48px;
    border-radius: 8px;
    margin: 8px;
    padding: 16px;
    border-width: 2px;
    transition-duration: 0.2s;
    cursor: link;
    background-color: rgb(58, 58, 58);
    color: rgb(0, 0, 0);
    border-color: rgb(68, 68, 68);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/ARCADE.TTF?fileID=12800000&guid=a385c4995ae72cc4aa84673209dc8c18&type=3#ARCADE");
    font-size: 35px;
    background-image: url("project://database/Assets/UI/Sprites/buttonBackground_48.png?fileID=2800000&guid=7b7f856678a70d24f94a37728a5806d0&type=3#buttonBackground_48");
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-scale: 1px;
    letter-spacing: 20px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-button {
    height: 48px;
    border-radius: 8px;
    margin: 8px;
    padding: 16px;
    border-width: 2px;
    transition-duration: 0.2s;
    cursor: link;
    background-color: rgb(58, 58, 58);
    border-color: rgb(68, 68, 68);
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 25px;
}

.btn:hover {
    background-color: rgb(74, 74, 74);
    border-color: rgb(74, 158, 255);
    scale: 1.05;
}

.unity-button:hover {
    background-color: rgb(74, 74, 74);
    border-color: rgb(74, 158, 255);
    scale: 1.05;
}

.btn:active {
    background-color: rgb(42, 42, 42);
    scale: 0.95;
}

.unity-button:active {
    background-color: rgb(42, 42, 42);
    scale: 0.95;
}

.btn--primary {
    background-color: rgb(74, 158, 255);
    border-color: rgb(46, 124, 214);
}

.btn--primary:hover {
    background-color: rgb(107, 179, 255);
}

.btn--primary:active {
    background-color: rgb(46, 124, 214);
}

.btn--danger {
    background-color: rgb(255, 74, 107);
    border-color: rgb(229, 74, 46);
}

.btn--danger:hover {
    background-color: rgb(255, 138, 107);
}

.btn--success {
    background-color: rgb(74, 255, 107);
    border-color: rgb(46, 229, 124);
}

.btn--success:hover {
    background-color: rgb(107, 255, 179);
}

.btn--large {
    height: 100px;
    font-size: 74px;
    min-width: 200px;
    -unity-text-align: upper-left;
}

.btn--small {
    height: 45px;
    min-width: 80px;
    padding: 8px;
}

.btn--close {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 75px;
    height: 75px;
    border-radius: 20px;
    align-items: flex-end;
}
