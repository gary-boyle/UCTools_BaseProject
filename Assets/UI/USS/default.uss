.defaultText {
    font-size: 37px;
    color: rgb(94, 94, 94);
}

.defaultPadding {
    margin-top: 12px;
    margin-right: 25px;
    margin-bottom: 12px;
    margin-left: 25px;
}

.baseUI {
    width: 100%;
    height: 100%;
    position: absolute;
    display: none;
}

.disabledButton {
    opacity: 0.4;
}

.defaultButton {
    font-size: 20px;
    background-color: rgb(197, 197, 197);
}

.screenBackground {
    background-color: rgb(0, 0, 0);
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.closeButtonPosition {
    position: absolute;
    align-self: flex-end;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.popup {
    align-self: center;
    padding-top: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    background-color: rgba(0, 0, 0, 0.53);
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    position: absolute;
}
