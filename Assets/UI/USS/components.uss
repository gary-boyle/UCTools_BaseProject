/* UI Components - Lists, Tabs, Progress Bars, Save Files */

.list {
    background-color: rgb(42, 42, 42);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(68, 68, 68);
    min-height: 200px;
    margin: 16px;
}

.unity-list-view {
    background-color: rgb(42, 42, 42);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(68, 68, 68);
    min-height: 200px;
    margin: 16px;
}

.list-item {
    background-color: rgb(58, 58, 58);
    border-radius: 4px;
    margin: 4px;
    padding: 16px;
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    transition-duration: 0.2s;
    color: rgb(255, 255, 255);
}

.unity-list-view__item {
    background-color: rgb(58, 58, 58);
    border-radius: 4px;
    margin: 4px;
    padding: 16px;
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    transition-duration: 0.2s;
    color: rgb(255, 255, 255);
}

.list-item:hover {
    background-color: rgb(74, 74, 74);
    border-color: rgb(74, 158, 255);
}

.unity-list-view__item:hover {
    background-color: rgb(74, 74, 74);
    border-color: rgb(74, 158, 255);
}

.unity-list-view__item:selected {
    background-color: rgb(74, 158, 255);
    border-color: rgb(107, 179, 255);
}

.unity-list-view__item--selected {
    background-color: rgb(74, 158, 255);
    border-color: rgb(107, 179, 255);
}

.unity-list-view__item:selected * {
    color: rgb(255, 255, 255);
}

.unity-list-view__item--selected * {
    color: rgb(255, 255, 255);
}

.save-file-header {
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.save-file-player {
    font-size: 20px;
    color: rgb(107, 179, 255);
    margin-right: 8px;
}

.save-file-autosave-indicator {
    font-size: 12px;
    color: rgb(74, 255, 158);
    background-color: rgb(26, 26, 26);
    padding: 4px;
    border-radius: 4px;
}

.save-file-difficulty {
    color: rgb(255, 184, 74);
    font-size: 14px;
}

.save-file-scene {
    color: rgb(204, 204, 204);
    font-size: 14px;
}

.save-file-date {
    font-size: 12px;
    color: rgb(153, 153, 153);
}

.save-file-time {
    font-size: 12px;
    color: rgb(153, 153, 153);
}

.save-file-time-container {
    justify-content: space-between;
}

.save-status-label {
    min-height: 20px;
}

.tab-view {
    background-color: rgb(42, 42, 42);
    border-radius: 16px;
    padding: 24px;
}

.tab-header {
    background-color: rgb(58, 58, 58);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(68, 68, 68);
    margin: 4px;
    padding: 16px;
    color: rgb(204, 204, 204);
}

.unity-tab__header {
    background-color: rgb(58, 58, 58);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(68, 68, 68);
    margin: 4px;
    padding: 16px;
    color: rgb(204, 204, 204);
}

.unity-tab__header--checked {
    background-color: rgb(74, 158, 255);
    color: rgb(255, 255, 255);
    border-color: rgb(107, 179, 255);
}

.tab-content {
    background-color: rgb(26, 26, 26);
    border-radius: 8px;
    padding: 24px;
    margin-top: 16px;
}

.unity-tab__content-container {
    background-color: rgb(26, 26, 26);
    border-radius: 8px;
    padding: 24px;
    margin-top: 16px;
}

.loading-progress {
    height: 12px;
    background-color: rgb(58, 58, 58);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(68, 68, 68);
}

.saving-progress {
    height: 12px;
    background-color: rgb(58, 58, 58);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(68, 68, 68);
}

.loading-progress .unity-progress-bar__background {
    background-color: rgb(58, 58, 58);
    border-radius: 6px;
}

.saving-progress .unity-progress-bar__background {
    background-color: rgb(58, 58, 58);
    border-radius: 6px;
}

.loading-progress .unity-progress-bar__progress {
    background-color: rgb(74, 158, 255);
    border-radius: 6px;
}

.saving-progress .unity-progress-bar__progress {
    background-color: rgb(74, 158, 255);
    border-radius: 6px;
}

.progress-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 80%;
    margin: 20px 0;
}
