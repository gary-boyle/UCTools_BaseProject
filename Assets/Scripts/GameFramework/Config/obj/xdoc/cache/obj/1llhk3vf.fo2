  - id: GameFramework.StateMachine.IGameStateMachine
    commentId: T:GameFramework.StateMachine.IGameStateMachine
    language: CSharp
    name:
      CSharp: IGameStateMachine
      VB: IGameStateMachine
    nameWithType:
      CSharp: IGameStateMachine
      VB: IGameStateMachine
    qualifiedName:
      CSharp: GameFramework.StateMachine.IGameStateMachine
