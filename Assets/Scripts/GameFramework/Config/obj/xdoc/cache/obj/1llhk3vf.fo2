  - id: GameFramework.Services.TimeService
    commentId: T:GameFramework.Services.TimeService
    language: CSharp
    name:
      CSharp: TimeService
      VB: TimeService
    nameWithType:
      CSharp: TimeService
      VB: TimeService
    qualifiedName:
      CSharp: GameFramework.Services.TimeService
      VB: GameFramework.Services.TimeService
    type: Class
    assemblies:
    - cs.temp.dll
    namespace: GameFramework.Services
    source:
      id: TimeService
      path: ''
      startLine: 9934
    summary: "\nTimeService manages game time tracking with proper pause handling and state awareness.\nTracks time only when in PlayingState and not paused.\nProvides formatted time display and session tracking capabilities.\n\nDesign: Uses event-driven architecture to respond to game state changes and pause events.\nPros: Accurate time tracking, integrates with pause system, provides multiple time formats\nCons: Depends on proper event firing from other systems\n"
    example: []
    syntax:
      content:
        CSharp: 'public class TimeService : ITimeService'
        VB: >-
          Public Class TimeService

              Inherits ITimeService
    inheritance:
