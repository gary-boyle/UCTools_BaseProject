  - id: GameFramework.Services.ConsoleService
    commentId: T:GameFramework.Services.ConsoleService
    language: CSharp
    name:
      CSharp: ConsoleService
      VB: ConsoleService
    nameWithType:
      CSharp: ConsoleService
      VB: ConsoleService
    qualifiedName:
      CSharp: GameFramework.Services.ConsoleService
      VB: GameFramework.Services.ConsoleService
    type: Class
    assemblies:
    - cs.temp.dll
    namespace: GameFramework.Services
    source:
      id: ConsoleService
      path: ''
      startLine: 7754
    summary: "\nService that orchestrates the debug console system using dependency injection.\n\nArchitecture:\n- Manages console state (open/closed)\n- Provides public API for other systems to interact with console\n- Respects debug settings from configuration\n- Input conflict management is handled by ConsoleInputHandler\n\nFlow:\n1. Receives toggle input events from InputManager\n2. Checks if console is enabled in debug settings\n3. Updates console open/closed state only if enabled\n4. ConsoleInputHandler automatically manages input conflicts by checking IsConsoleOpen()\n5. Delegates UI updates to ConsoleGUI via Console static class\n"
    example: []
    syntax:
      content:
        CSharp: 'public class ConsoleService : IConsoleService'
        VB: >-
          Public Class ConsoleService

              Inherits IConsoleService
    inheritance:
    - System.Object
    implements:
    - IUpdatable
    - ILateUpdatable
    modifiers:
      CSharp:
      - public
      - class
      VB:
      - Public
      - Class
    items:
    - id: GameFramework.Services.ConsoleService.#ctor(ConsoleGUI,IEventSystem,IConfigService)
      commentId: M:GameFramework.Services.ConsoleService.#ctor(ConsoleGUI,IEventSystem,IConfigService)
      language: CSharp
