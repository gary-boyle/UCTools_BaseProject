    type: Interface
    assemblies:
    - cs.temp.dll
    namespace: GameFramework.StateMachine
    source:
      id: IGameStateMachine
      path: ''
      startLine: 11834
    summary: "\nAdvanced state machine with constructor injection support.\nAll dependencies are injected rather than resolved from service locator.\nUses explicit state definitions for maximum Unity compatibility.\n\nDesign: State machine pattern with async support and transition validation\nPros: Robust state management, prevents invalid transitions, supports complex state logic, Unity compatible\nCons: More complex than simple state switching, requires careful transition planning, explicit state definitions\n"
    example: []
    syntax:
      content:
        CSharp: public interface IGameStateMachine
        VB: >-
          Public Interface IGameStateMachine

              Inherits IGameService
    modifiers:
      CSharp:
      - public
      - interface
      VB:
      - Public
      - Interface
    items:
