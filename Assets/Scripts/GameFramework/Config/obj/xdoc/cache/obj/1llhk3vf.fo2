    namespace: UCTools_ConfigVariables
    source:
      id: ConfigFlags
      path: ''
      startLine: 17461
    summary: "\nBehavioral flags that control how configuration variables are handled\nCan be combined using bitwise OR to give variables multiple behaviors\n\nUsage Examples:\n- Flags.Save: Variable persists between sessions\n- Flags.Save | Flags.ServerInfo: Variable persists AND is sent to clients\n- Flags.Cheat: Variable can only be modified when cheats are enabled\n"
    example: []
    syntax:
      content:
        CSharp: public enum ConfigFlags
        VB: Public Enum ConfigFlags
    modifiers:
      CSharp:
      - public
      - enum
      VB:
      - Public
      - Enum
