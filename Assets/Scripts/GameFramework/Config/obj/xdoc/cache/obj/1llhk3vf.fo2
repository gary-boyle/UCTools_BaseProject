  - id: GameFramework.ConsoleTool.Commands.ExampleCommand
    commentId: T:GameFramework.ConsoleTool.Commands.ExampleCommand
    language: CSharp
    name:
      CSharp: ExampleCommand
      VB: ExampleCommand
    nameWithType:
      CSharp: ExampleCommand
      VB: ExampleCommand
    qualifiedName:
      CSharp: GameFramework.ConsoleTool.Commands.ExampleCommand
      VB: GameFramework.ConsoleTool.Commands.ExampleCommand
    type: Class
    assemblies:
    - cs.temp.dll
    namespace: GameFramework.ConsoleTool.Commands
    source:
      id: ExampleCommand
      path: ''
      startLine: 2005
    summary: "\nExample console command that demonstrates how to create custom commands\nThis command creates primitive GameObjects in the scene for testing and demonstration\n\nUsage Examples:\n> spawn                    - Creates a cube at origin (0,0,0)\n> spawn sphere             - Creates a sphere at origin\n> spawn cube 5 10 0        - Creates a cube at position (5, 10, 0)\n> spawn cylinder 0 5 0 red - Creates a red cylinder at (0, 5, 0)\n\nThis serves as a template for creating your own console commands\nCopy this file and modify it to create new functionality\n"
    example: []
    syntax:
      content:
        CSharp: 'public class ExampleCommand : ConsoleCommandBase, IConsoleCommand'
        VB: >-
          Public Class ExampleCommand

              Inherits ConsoleCommandBase

              Implements IConsoleCommand
    inheritance:
    - System.Object
    - GameFramework.ConsoleTool.Commands.ConsoleCommandBase
    implements:
    - GameFramework.ConsoleTool.IConsoleCommand
