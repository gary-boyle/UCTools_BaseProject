  - id: GameFramework.UI.Utilities.GraphElement
    commentId: T:GameFramework.UI.Utilities.GraphElement
    language: CSharp
    name:
      CSharp: GraphElement
      VB: GraphElement
    nameWithType:
      CSharp: GraphElement
      VB: GraphElement
    qualifiedName:
      CSharp: GameFramework.UI.Utilities.GraphElement
      VB: GameFramework.UI.Utilities.GraphElement
    type: Class
    assemblies:
    - cs.temp.dll
    namespace: GameFramework.UI.Utilities
    source:
      id: GraphElement
      path: ''
      startLine: 15734
    summary: "\nCustom UI element that renders a simple line graph for performance metrics\n\nDesign:\n- Uses Unity&apos;s MeshGenerationContext for efficient rendering\n- Circular buffer for memory-efficient data storage\n- Configurable colors, ranges, and smoothing\n- Auto-scaling based on data range\n\nPros:\n- Efficient rendering using Unity&apos;s native mesh generation\n- Memory efficient with fixed-size circular buffer\n- Smooth visual updates with configurable sampling\n- Auto-scaling prevents data clipping\n\nCons:\n- Custom rendering adds complexity\n- Limited to simple line graphs\n- Requires manual styling integration\n"
    example: []
    syntax:
      content:
        CSharp: 'public class GraphElement : VisualElement'
        VB: >-
          Public Class GraphElement

              Inherits VisualElement
    inheritance:
    - System.Object
    modifiers:
      CSharp:
      - public
      - class
      VB:
      - Public
