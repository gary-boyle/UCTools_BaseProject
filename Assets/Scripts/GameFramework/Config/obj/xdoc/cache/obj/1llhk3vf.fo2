    source:
      id: SaveService
      path: ''
      startLine: 9441
    summary: "\nEnhanced save service that handles both file operations and UI support\nProvides clean separation between low-level file I/O and high-level UI operations\nUses timestamp-based naming for all save files with special autosave handling\nAutosaves always overwrite existing autosave files to prevent save directory bloat\nWorks with GameDataService as the single source of session data\nIntegrates with TimeService for accurate playtime tracking\n"
    example: []
    syntax:
      content:
        CSharp: 'public class SaveService : ISaveService'
        VB: >-
          Public Class SaveService

              Inherits ISaveService
