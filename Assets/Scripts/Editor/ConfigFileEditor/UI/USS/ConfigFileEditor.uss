.window-root {
    flex-direction: column;
    flex-grow: 1;
}

.main-toolbar {
    border-bottom-width: 1px;
    border-bottom-color: rgb(99, 99, 99);
    padding: 2px 4px;
}

.toolbar-button {
    margin-left: 2px;
    margin-right: 2px;
}

.toolbar-toggle {
    margin-left: 2px;
    margin-right: 2px;
}

.primary-button {
    background-color: rgba(100, 150, 255, 0.8);
}

.primary-button:hover {
    background-color: rgb(100, 150, 255);
}

.status-bar {
    border-top-width: 1px;
    border-top-color: rgb(99, 99, 99);
    padding: 2px 4px;
    background-color: rgb(42, 42, 42);
}

.status-message {
    font-size: 11px;
}

.status-message.error {
    color: rgb(255, 100, 100);
}

.status-message.warning {
    color: rgb(255, 200, 100);
}

.status-message.info {
    color: rgb(200, 200, 200);
}

.changes-indicator {
    font-size: 11px;
    color: rgb(255, 200, 100);
}

.save-indicator {
    font-size: 11px;
    color: rgb(100, 255, 100);
}

.content-area {
    flex-direction: row;
    flex-grow: 1;
}

.left-panel {
    width: 280px;
    min-width: 220px;
    background-color: rgba(26, 26, 26, 0.2);
    padding: 10px;
    border-right-width: 1px;
    border-right-color: rgb(99, 99, 99);
}

.panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    color: rgb(220, 220, 220);
}

.info-section {
    margin-bottom: 20px;
    padding: 8px;
    background-color: rgba(51, 51, 51, 0.2);
    border-radius: 4px;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: rgb(200, 200, 200);
}

.file-status {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.status-indicator {
    font-size: 16px;
    margin-right: 6px;
    min-width: 16px;
}

.status-indicator.exists {
    color: rgb(100, 255, 100);
}

.status-indicator.missing {
    color: rgb(255, 100, 100);
}

.status-indicator.modified {
    color: rgb(255, 200, 100);
}

.status-text {
    font-size: 11px;
    color: rgb(180, 180, 180);
}

.file-details {
    margin-left: 22px;
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.detail-label {
    font-size: 10px;
    color: rgb(150, 150, 150);
    min-width: 60px;
}

.detail-value {
    font-size: 10px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-right;
}

.actions-container {
    flex-direction: column;
}

.action-button {
    margin-bottom: 4px;
    height: 22px;
    font-size: 11px;
}

.delete-button {
    background-color: rgba(204, 51, 51, 0.8);
}

.delete-button:hover {
    background-color: rgb(204, 51, 51);
}

.validation-status {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.validation-indicator {
    font-size: 16px;
    margin-right: 6px;
    min-width: 16px;
}

.validation-indicator.valid {
    color: rgb(100, 255, 100);
}

.validation-indicator.invalid {
    color: rgb(255, 100, 100);
}

.validation-indicator.unknown {
    color: rgb(150, 150, 150);
}

.validation-text {
    font-size: 10px;
    color: rgb(180, 180, 180);
}

.right-container {
    flex-direction: column;
    flex-grow: 1;
    min-width: 400px;
}

.no-file-message {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.no-file-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(180, 180, 180);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.no-file-subtitle {
    font-size: 12px;
    color: rgb(150, 150, 150);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.create-file-button {
    height: 32px;
    padding: 8px 16px;
    background-color: rgba(100, 150, 255, 0.8);
    font-size: 12px;
}

.create-file-button:hover {
    background-color: rgb(100, 150, 255);
}

.config-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 10px;
}

.structured-editor {
    flex-direction: column;
    flex-grow: 1;
}

.editor-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(99, 99, 99, 0.3);
}

.editor-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
}

.add-entry-button {
    background-color: rgba(100, 200, 100, 0.8);
    height: 24px;
    padding: 4px 8px;
    font-size: 11px;
}

.add-entry-button:hover {
    background-color: rgb(100, 200, 100);
}

.config-properties-container {
    flex-grow: 1;
    padding: 4px;
}

.raw-json-editor {
    flex-direction: column;
    flex-grow: 1;
}

.format-json-button {
    height: 24px;
    padding: 4px 8px;
    font-size: 11px;
    background-color: rgba(150, 150, 150, 0.6);
}

.format-json-button:hover {
    background-color: rgba(150, 150, 150, 0.8);
}

.json-editor-container {
    flex-grow: 1;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.5);
}

.json-text-field {
    flex-grow: 1;
    min-height: 300px;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 11px;
    white-space: pre;
    -unity-text-align: upper-left;
}

.json-text-field .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 8px;
}

.property-item {
    margin-bottom: 4px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.02);
}

.property-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.property-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    min-height: 24px;
}

.expand-button {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    font-size: 10px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

.expand-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.key-field {
    min-width: 100px;
    max-width: 150px;
    font-size: 11px;
    margin-right: 4px;
}

.key-field .unity-text-field__input {
    background-color: rgba(100, 100, 100, 0.2);
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.5);
    padding: 2px 4px;
}

.property-separator {
    margin: 0 4px;
    color: rgb(150, 150, 150);
}

.value-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.value-field {
    flex-grow: 1;
    font-size: 11px;
    margin-right: 4px;
    background-color: rgb(36, 36, 36);
}

.value-field .unity-text-field__input {
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.3);
    padding: 2px 4px;
}

.value-field .unity-base-field__input {
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.3);
    padding: 2px 4px;
}

.delete-button {
    width: 20px;
    height: 20px;
    margin-left: 4px;
    font-size: 12px;
    padding: 0;
    background-color: rgba(204, 51, 51, 0.6);
    color: white;
}

.delete-button:hover {
    background-color: rgba(204, 51, 51, 0.8);
}

.property-children {
    margin-left: 20px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: rgba(99, 99, 99, 0.3);
}

.hidden {
    display: none;
}

.property-item.collapsed .property-children {
    display: none;
}

.property-item.collapsed .expand-button {
    -unity-text-align: middle-center;
}

.property-item.expanded .expand-button {
    -unity-text-align: middle-center;
}

.value-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.value-field {
    flex-grow: 1;
    font-size: 11px;
    margin-right: 0;
}

.value-field .unity-text-field__input {
    background-color: rgba(80, 80, 80, 0.3);
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.3);
    padding: 2px 4px;
}

.value-field .unity-base-field__input {
    background-color: rgba(80, 80, 80, 0.3);
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.3);
    padding: 2px 4px;
}

.type-dropdown {
    flex-grow: 1;
    font-size: 11px;
    margin-right: 0;
    min-width: 120px;
}

.type-dropdown .unity-base-field__input {
    background-color: rgba(80, 80, 80, 0.3);
    border-width: 1px;
    border-color: rgba(99, 99, 99, 0.3);
    padding: 2px 4px;
}

.type-dropdown:hover .unity-base-field__input {
    background-color: rgba(80, 80, 80, 0.4);
}

.value-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.value-field {
    flex-grow: 1;
    font-size: 11px;
    margin-right: 0;
}

.invalid-input .unity-text-field__input {
    border-color: rgb(255, 100, 100);
    background-color: rgba(255, 100, 100, 0.1);
}

.invalid-input {
    color: rgb(255, 150, 150);
}

.unity-base-field__label {
    background-color: rgb(70, 70, 70);
}
